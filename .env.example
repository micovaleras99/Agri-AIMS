# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agri_aims
DB_POOL_LIMIT=10

# Log every SQL statement and its timing
DB_LOG_QUERIES=false

# Auth (REST API + web session cookie)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=3000
# NODE_ENV also controls error detail: API stack traces are returned only when
# this is exactly "development". Anything else, including leaving it unset,
# returns a generic message. Errors are always written to the server log.
NODE_ENV=development

# Cross-origin browser access. Leave this unset and browsers on other origins
# cannot call the API at all, which is what you want for a server-rendered app:
# the site's own pages are same-origin, and Bearer-token clients such as Postman
# or a future mobile app are not governed by CORS. Set it only when a browser on
# a different origin must call this API. Comma-separated, exact origins.
# CORS_ORIGIN=http://localhost:3000,https://agri-aims.example

# Append HTTP request lines to logs/request.log
LOG_TO_FILE=false

# Set when running behind a reverse proxy so rate limiting sees the real client IP.
# A number = how many proxy hops to trust. Leave unset when facing users directly.
# TRUST_PROXY=1

# Development only: allows ?role=admin to sign in without a password.
# Leave false unless you are demoing locally. Ignored when NODE_ENV=production.
ALLOW_ROLE_SWITCH=false

# e-Learning monitoring (RSC-03). Without a token the system runs in manual mode
# and staff add announcements at /admin/elearning.
ELEARNING_SOURCE=manual
MOODLE_URL=https://elearn.e-extension.gov.ph
MOODLE_TOKEN=
# The Site announcements forum id, if you want announcements as well as courses
MOODLE_ANNOUNCEMENT_FORUM_ID=
# Chat channel the sync posts into
ELEARNING_CHANNEL_SLUG=e-learning
# e-Learning announcements are also mirrored into #general by default. Comma-
# separated list of extra channel slugs; set empty to post only to
# ELEARNING_CHANNEL_SLUG.
# ELEARNING_MIRROR_CHANNEL_SLUGS=general

# Who this office is. These appear on the endorsement letter and on the
# certificate the farmer receives, so set them for your deployment. Defaults are
# ATI-RTC V (Bicol).
# ORG_DIRECTOR=JUAN A. SANTOS, Ph.D.
# ORG_DIRECTOR_TITLE=Center Director
# ORG_OFFICE=ATI-RTC V (Bicol)
# ORG_OFFICE_SHORT=ATI-RTC V
# ORG_ADDRESS=Diversion Road, San Agustin, Pili, Camarines Sur
# ORG_CENTRAL_OFFICE=ATI Central Office, Diliman, Quezon City
# ORG_EMAIL=rtc5_dcc@ati.da.gov.ph
# ORG_PHONE=054-477-1579

# ── ATI Bicol website monitoring (RSC-03) ───────────────────────
# Set ELEARNING_SOURCE=ati to read https://ati2.da.gov.ph/ati-5/content/ and
# post new articles into community chat. The site offers no RSS, API or sitemap
# (all checked), so this parses the server-rendered listing. It makes ONE request
# per run and identifies itself; run it hourly at most, daily is kinder.
# ELEARNING_SOURCE=ati
# ATI_SITE_URL=https://ati2.da.gov.ph
# ATI_LISTING_PATH=/ati-5/content/
# ATI_CHANNEL_SLUG=region-v-bicol
# ATI news is also mirrored into #general by default so the main channel carries
# it too. Comma-separated list of extra channel slugs; set empty to post only to
# ATI_CHANNEL_SLUG.
# ATI_MIRROR_CHANNEL_SLUGS=general
# ATI_USER_AGENT=agri-aims/1.0 (ATI-RTC V Learning Site monitor; +mailto:rtc5_dcc@ati.da.gov.ph)
# Most posts to make in a single run. The rest are recorded as seen so a first
# run against 50 existing articles does not flood the channel.
# SYNC_MAX_POSTS=5

# Run the article sync automatically while the server is up. Unset = off, and
# nothing reaches the internet on its own. Values under 15 are raised to 15:
# the ATI site sends no-cache on a 121 KB page, so polling harder is rude and
# pointless. Windows Task Scheduler calling "npm run sync:elearning" is the
# better choice if runs must happen while the app is stopped — both are safe
# together, because the sync deduplicates by unique key.
# SYNC_INTERVAL_MINUTES=180

# ── Chatbot language model (RSC-06), optional ───────────────────
# Any OpenAI-compatible provider. Leave AI_API_KEY unset and the chatbot keeps
# answering from the system's own LSA data at no cost — that is the default.

# OpenAI (ChatGPT) — no free tier, billing must be set up.
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-xxxxxxxx
#   AI_MODEL=gpt-4o-mini

# AI_TIMEOUT_MS=20000
# AI_MAX_TOKENS=400

# ── Notification email (optional) ───────────────────────────────────────────
# With these unset, notifications appear only in the bell inside the app and
# nothing is sent anywhere. Set them and every notification is also emailed to
# the address the user registered with.
#
# GMAIL NEEDS AN APP PASSWORD, not your account password. Turn on 2-Step
# Verification, then create one at myaccount.google.com/apppasswords and paste
# the 16 characters as SMTP_PASS.
#
# For a defence, consider Mailtrap (sandbox.smtp.mailtrap.io, port 2525) — it
# captures everything the system sends without delivering to real inboxes, so a
# demo cannot post test mail to a panelist's address.
#
# Prove the settings before relying on them:  npm run mail:check -- you@mail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Agri-AIMS <your.address@gmail.com>
# 465 requires SMTP_SECURE=true; 587 and 2525 upgrade with STARTTLS instead.
SMTP_SECURE=false
# Used to build the links inside the emails.
APP_BASE_URL=http://localhost:3000
