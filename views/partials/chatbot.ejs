<!-- ═══════════════════════════════════════════════════════
     PARTIAL: chatbot.ejs — AgriBot AI Assistant Widget
     ═══════════════════════════════════════════════════════ -->

<!-- Floating Bubble -->
<div class="chatbot-bubble" id="chatbotBubble" role="button" tabindex="0"
     aria-label="Open AgriBot assistant" aria-expanded="false" aria-controls="chatbotWidget"
     data-call="toggleChatbot">
    <i class="bi bi-robot chatbot-bubble-icon" aria-hidden="true"></i>
    <span class="chatbot-bubble-badge" id="chatbotBadge" style="display:none;">1</span>
    <div class="chatbot-bubble-tooltip">AgriBot Assistant</div>
</div>

<!-- Chat Panel -->
<div class="chatbot-widget" id="chatbotWidget" style="display:none;">
    <div class="chatbot-header" id="chatbotDragHandle">
        <div class="chatbot-header-avatar">
            <i class="bi bi-robot"></i>
        </div>
        <div class="chatbot-header-info">
            <span class="chatbot-title">AgriBot Assistant</span>
            <span class="chatbot-status">
                <i class="bi bi-circle-fill"></i> Online
            </span>
        </div>
        <button class="chatbot-close-btn" data-call="clearChatbot" title="Clear conversation" aria-label="Clear conversation">
            <i class="bi bi-trash"></i>
        </button>
        <button class="chatbot-close-btn" data-call="toggleChatbot" data-args='["@event"]' title="Minimize">
            <i class="bi bi-dash-lg"></i>
        </button>
    </div>
    <div class="chatbot-body">
        <%
           // The signed-in user's face for their own chat bubbles, drawn the same
           // way partials/avatar does it: photo when there is one, initials
           // otherwise. Read by public/js/main.js when it appends a user message.
           var cbUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
           var cbPhoto = cbUser && cbUser.photo ? ('/profile/photo/' + cbUser.id) : '';
           var cbInitials = cbUser && cbUser.avatar ? cbUser.avatar : '';
        %>
        <div class="chatbot-messages" id="chatbotMessages"
             data-user-id="<%= cbUser ? cbUser.id : '' %>"
             data-user-photo="<%= cbPhoto %>" data-user-initials="<%= cbInitials %>">
            <div class="chatbot-message bot">
                <div class="message-avatar"><i class="bi bi-robot"></i></div>
                <div class="message-content">
                    <p>Hello! I'm AgriBot, your LSA application assistant. How can I help you today?</p>
                    <div class="quick-replies">
                        <button class="quick-reply"
                                data-call="sendQuickReply" data-args='["How to apply for LSA?"]'>
                            How to apply?
                        </button>
                        <button class="quick-reply"
                                data-call="sendQuickReply" data-args='["Required documents"]'>
                            Required documents
                        </button>
                        <button class="quick-reply"
                                data-call="sendQuickReply" data-args='["Check application status"]'>
                            Application status
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="chatbot-input">
            <input type="text" id="chatbotInput"
                   placeholder="Ask me anything..."
                   data-call="handleChatbotEnter" data-on="keypress" data-args='["@event"]'>
            <button data-call="sendChatbotMessage"
                    aria-label="Send message to AgriBot" title="Send">
                <i class="bi bi-send" aria-hidden="true"></i>
            </button>
        </div>
    </div>
</div>
