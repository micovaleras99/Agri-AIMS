<!-- ═══════════════════════════════════════════════════════
     PARTIAL: sidebar.ejs — Side Navigation (optional use)
     Variables: page (active page string)
     ═══════════════════════════════════════════════════════ -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <i class="bi bi-flower1 brand-icon"></i>
        <span class="brand-text">Agri-AIMS</span>
    </div>

    <nav class="sidebar-nav">
        <div class="sidebar-section-label">MAIN</div>

        <a href="/dashboard"
           class="sidebar-link <%= page === 'dashboard'  ? 'active' : '' %>">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>
        <a href="/applicants"
           class="sidebar-link <%= page === 'applicants' ? 'active' : '' %>">
            <i class="bi bi-file-earmark-text"></i>
            <span>Applications</span>
        </a>
        <a href="/farms"
           class="sidebar-link <%= page === 'farms'      ? 'active' : '' %>">
            <i class="bi bi-tree"></i>
            <span>LSA Farms</span>
        </a>
        <a href="/documents"
           class="sidebar-link <%= page === 'documents'  ? 'active' : '' %>">
            <i class="bi bi-folder"></i>
            <span>Documents</span>
        </a>

        <div class="sidebar-section-label mt-3">ANALYTICS</div>

        <a href="/reports"
           class="sidebar-link <%= page === 'reports'    ? 'active' : '' %>">
            <i class="bi bi-bar-chart-line"></i>
            <span>Reports</span>
        </a>
        <a href="/directory"
           class="sidebar-link <%= page === 'directory'  ? 'active' : '' %>">
            <i class="bi bi-building"></i>
            <span>LSA Directory</span>
        </a>

        <div class="sidebar-section-label mt-3">COMMUNITY</div>

        <a href="/community"
           class="sidebar-link <%= page === 'community'  ? 'active' : '' %>">
            <i class="bi bi-chat-dots"></i>
            <span>Community Chat</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="user-avatar-sm">AD</div>
            <div>
                <div class="sidebar-user-name">Administrator</div>
                <div class="sidebar-user-role">ATI Staff</div>
            </div>
        </div>
    </div>
</aside>
