<%- include('../partials/header') %>
<!-- Leaflet CSS — open-source map, no API key needed -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<%- include('../partials/navbar', { page, currentUser, role }) %>

<div class="main-wrapper">
    <div class="page-content">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/applicants">Applications</a></li>
                <li class="breadcrumb-item active"><%= applicant.applicationId %></li>
            </ol>
        </nav>

        <!-- Alerts -->
        <% if (typeof query !== 'undefined' && query.geotagged) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="ph-fill ph-map-pin me-2"></i>
            <strong>Geo-tag recorded successfully!</strong>
            Farm location has been logged. Application advanced to Step 5 — Field Validation.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.certified) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="ph-fill ph-medal me-2"></i>
            <strong>Certificate issued.</strong>
            <%= applicant.farmName %> is now an accredited Learning Site
            <% if (query.farm) { %>—
            <a href="/farms/<%= query.farm %>" class="alert-link">open its record</a>,
            <% } %>
            and <%= applicant.firstName %> now signs in as its LSA Operator.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.geoerror) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <i class="ph ph-warning me-2"></i>
            Invalid coordinates. Please enter valid coordinates within the Philippines (Lat: 10–20°N, Lng: 118–128°E).
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="ph ph-check-circle me-2"></i>Application updated successfully.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>
        <% if (typeof query !== 'undefined' && query.nopackage) { %>
        <div class="alert alert-warning alert-dismissible fade show mb-4">
            <i class="ph ph-warning me-2"></i>
            No validated documents yet — accept the application's documents before downloading the package.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <div class="row g-4">

            <!-- ── LEFT: Applicant Profile ─────────────────────── -->
            <div class="col-lg-4">
                <div class="card mb-4">
                    <div class="card-body text-center p-4">
                        <div class="detail-avatar mb-3">
                            <%= applicant.firstName[0] %><%= applicant.lastName[0] %>
                        </div>
                        <h4><%= applicant.firstName %> <%= applicant.lastName %></h4>
                        <span class="status-badge <%= applicant.status %> px-3 py-2 mb-3 d-inline-block">
                            <%= applicant.status.replace(/_/g,' ') %>
                        </span>
                        <div class="detail-info-list text-start mt-2">
                            <div class="detail-info-item">
                                <i class="ph ph-hash"></i>
                                <span class="app-id-link"><%= applicant.applicationId %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-envelope"></i><span><%= applicant.email %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-phone"></i><span><%= applicant.phone %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-calendar-blank"></i><span>Submitted: <%= applicant.submissionDate %></span>
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-4 flex-wrap">
                            <a href="/accreditation/<%= applicant.id %>"
                               class="btn btn-success w-100 mb-1">
                                <i class="ph ph-tree-structure me-1"></i>
                                <%= applicant.status === 'approved' ? 'View Accreditation' : 'Manage Accreditation Steps' %>
                            </a>
                        </div>
                        <% if (['admin'].includes(role)) { %>
                        <div class="d-flex gap-2 mt-2">
                            <a href="/documents/package/<%= applicant.id %>"
                               class="btn btn-outline-success w-100"
                               title="Download all validated documents as a ZIP for the Central Office submission">
                                <i class="ph ph-file-zip me-1"></i>Download Validated Documents
                            </a>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <a href="/applicants/edit/<%= applicant.id %>"
                               class="btn btn-primary flex-fill">
                                <i class="ph ph-pencil-simple me-1"></i>Edit
                            </a>
                            <% if (role === 'admin') { %>
                            <form action="/applicants/delete/<%= applicant.id %>"
                                  method="POST"
                                  data-confirm="Permanently delete this applicant and ALL its records — documents, self-assessment, development plan and accreditation history? This cannot be undone. To only stop the login, deactivate the account from Accounts instead.">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button class="btn btn-outline-danger"
                                        aria-label="Delete this application" title="Delete this application">
                                    <i class="ph ph-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                            <% } %>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Farm Info -->
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">
                            <i class="ph ph-tree me-2 text-success"></i>Farm Information
                        </h6>
                        <div class="detail-info-list">
                            <div class="detail-info-item">
                                <i class="ph ph-building"></i><span><%= applicant.farmName %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-ruler"></i>
                                <span><%= applicant.farmArea.toLocaleString() %> sq.m.</span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-map-pin"></i>
                                <span><%= applicant.municipality %>, <%= applicant.province %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-map-trifold"></i>
                                <span><%= applicant.farmAddress %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-tag"></i>
                                <span><%= classificationLabel(applicant.classification) %></span>
                            </div>
                            <div class="detail-info-item">
                                <i class="ph ph-medal"></i>
                                <span><%= applicant.lsaType.toUpperCase() %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── RIGHT: Tracker + Geo-Tagging ─────────────────── -->
            <div class="col-lg-8">

                <!-- Progress -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">
                                <i class="ph ph-tree-structure me-2 text-primary"></i>Accreditation Progress
                            </h5>
                            <span class="fs-5 fw-bold text-primary"><%= applicant.progress %>%</span>
                        </div>
                        <div class="progress mb-3" style="height:12px;border-radius:6px;">
                            <div class="progress-bar" style="width:<%= applicant.progress %>%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Step <%= applicant.accreditationStep %> of 7</span>
                            <span><i class="ph ph-folder me-1"></i>Documents: <%= applicant.documents %>/<%= applicant.totalDocs %></span>
                        </div>
                    </div>
                </div>

                <!-- Document Status Summary -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon bg-success"><i class="ph ph-seal-check"></i></div>
                            <div class="stat-info"><h3><%= docStats.verified %></h3><p>Verified</p></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon bg-warning"><i class="ph ph-hourglass"></i></div>
                            <div class="stat-info"><h3><%= docStats.pending %></h3><p>Pending</p></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="stat-card">
                            <div class="stat-icon bg-danger"><i class="ph ph-warning-circle"></i></div>
                            <div class="stat-info"><h3><%= docStats.missing %></h3><p>Missing</p></div>
                        </div>
                    </div>
                </div>

                <!-- 7-Step Tracker -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">
                            <i class="ph ph-list-checks me-2 text-primary"></i>7-Step LSA Accreditation
                        </h5>
                        <div class="accreditation-tracker">
                        <% accreditationSteps.forEach((s, i) => {
                            let sc = s.step < applicant.accreditationStep ? 'completed'
                                   : s.step === applicant.accreditationStep ? 'active' : '';
                        %>
                        <div class="tracker-step <%= sc %>">
                            <div class="tracker-circle">
                                <% if (sc === 'completed') { %>
                                    <i class="ph ph-check"></i>
                                <% } else { %><%= s.step %><% } %>
                            </div>
                            <% if (i < accreditationSteps.length - 1) { %>
                            <div class="tracker-line <%= sc === 'completed' ? 'completed' : '' %>"></div>
                            <% } %>
                            <div class="tracker-label">
                                <i class="<%= ic(s.icon) %>"></i>
                                <span><%= s.label %></span>
                                <% if (s.step === 5) { %>
                                <span class="geo-step-badge">GIS</span>
                                <% } %>
                            </div>
                        </div>
                        <% }) %>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════
                     GEO-TAGGING MODULE
                     Responsible: Evaluator (TWG) during Step 5
                     Source: ATI Briefer — "Field/Virtual Validation
                     shall be undertaken by the TWG"
                     Pre-Proposal — "Geo-Tagging and GIS-Based
                     Monitoring Module"
                     ══════════════════════════════════════════════ -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="card-header-row mb-3">
                            <div>
                                <h5 class="card-title mb-0">
                                    <i class="ph-fill ph-map-pin me-2 text-danger"></i>
                                    Geo-Tagging &amp; GIS Location
                                    <span class="badge bg-<%= applicant.geoTagStatus === 'tagged' ? 'success' : 'secondary' %>-subtle
                                                  text-<%= applicant.geoTagStatus === 'tagged' ? 'success' : 'secondary' %>
                                                  border ms-2" style="font-size:11px;">
                                        <i class="<%= ic(applicant.geoTagStatus === 'tagged' ? 'check-circle' : 'clock') %> me-1"></i>
                                        <%= applicant.geoTagStatus === 'tagged' ? 'Tagged' : 'Pending Tag' %>
                                    </span>
                                </h5>
                                <p class="text-muted small mb-0 mt-1">
                                    <% if (applicant.geoTagStatus === 'tagged') { %>
                                    Tagged by <strong><%= applicant.geoTaggedBy %></strong>
                                    on <strong><%= applicant.geoTaggedDate %></strong> during Step 5 field validation.
                                    <% } else { %>
                                    GPS coordinates recorded by the TWG Evaluator during Step 5 — Field/Virtual Validation.
                                    <% } %>
                                </p>
                            </div>
                            <% if (role === 'admin') { %>
                            <button class="btn btn-sm btn-outline-danger"
                                    data-call="toggleGeoPanel">
                                <i class="ph ph-map-pin me-1"></i>
                                <%= applicant.geoTagStatus === 'tagged' ? 'Update Tag' : 'Record Location' %>
                            </button>
                            <% } %>
                        </div>

                        <!-- Map display — always shown if tagged -->
                        <% if (applicant.latitude && applicant.longitude) { %>
                        <div id="farmMap" class="farm-map-container mb-3"></div>
                        <div class="geo-coords-display">
                            <div class="geo-coord-item">
                                <i class="ph ph-crosshair text-danger"></i>
                                <span class="fw-semibold">Latitude:</span>
                                <span class="font-monospace"><%= applicant.latitude %>°N</span>
                            </div>
                            <div class="geo-coord-item">
                                <i class="ph ph-crosshair text-primary"></i>
                                <span class="fw-semibold">Longitude:</span>
                                <span class="font-monospace"><%= applicant.longitude %>°E</span>
                            </div>
                            <div class="geo-coord-item">
                                <i class="ph ph-identification-badge text-success"></i>
                                <span class="fw-semibold">Tagged by:</span>
                                <span><%= applicant.geoTaggedBy || '—' %></span>
                            </div>
                            <div class="geo-coord-item">
                                <i class="ph ph-calendar-blank text-info"></i>
                                <span class="fw-semibold">Date:</span>
                                <span><%= applicant.geoTaggedDate || '—' %></span>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="geo-pending-placeholder">
                            <i class="ph ph-map-pin fs-1 text-secondary d-block mb-2"></i>
                            <p class="text-muted mb-1 fw-semibold">Farm not yet geo-tagged</p>
                            <p class="text-muted small">
                                Coordinates will be recorded by the ATI Evaluator (TWG)
                                during Step 5 — Field/Virtual Validation.
                            </p>
                            <% if (['admin'].includes(role)) { %>
                            <button class="btn btn-sm btn-outline-danger mt-2"
                                    data-call="recordLocationNow" data-args='["@this"]'>
                                <i class="ph ph-map-pin me-1"></i>Record Location Now
                            </button>
                            <% } %>
                        </div>
                        <% } %>

                        <!-- ── GEO-TAG INPUT FORM (Evaluator/Admin only) ── -->
                        <% if (['admin'].includes(role)) { %>
                        <div id="geoTagPanel" class="geo-tag-panel <%= applicant.geoTagStatus === 'tagged' ? 'd-none' : '' %>">
                            <div class="geo-tag-panel-header">
                                <i class="ph-fill ph-map-pin text-danger me-2"></i>
                                <strong>Record GPS Coordinates</strong>
                                <span class="ms-2 text-muted small">Step 5 — Field/Virtual Validation (ATI Briefer)</span>
                            </div>

                            <form action="/applicants/geotag/<%= applicant.id %>" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label for="latInput" class="form-label fw-semibold small">
                                            <i class="ph ph-crosshair text-danger me-1"></i>
                                            Latitude <span class="text-muted fw-normal">(e.g. 13.6218)</span>
                                        </label>
                                        <input type="number" class="form-control font-monospace"
                                               name="latitude" id="latInput"
                                               step="0.0001" min="10" max="20"
                                               value="<%= applicant.latitude || '' %>"
                                               placeholder="13.6218"
                                               data-call="updateMapPreview" data-on="input"
                                               required>
                                        <div class="form-text">Philippines range: 10°N – 20°N</div>
                                    </div>
                                    <div class="col-md-5">
                                        <label for="lngInput" class="form-label fw-semibold small">
                                            <i class="ph ph-crosshair text-primary me-1"></i>
                                            Longitude <span class="text-muted fw-normal">(e.g. 123.1948)</span>
                                        </label>
                                        <input type="number" class="form-control font-monospace"
                                               name="longitude" id="lngInput"
                                               step="0.0001" min="118" max="128"
                                               value="<%= applicant.longitude || '' %>"
                                               placeholder="123.1948"
                                               data-call="updateMapPreview" data-on="input"
                                               required>
                                        <div class="form-text">Philippines range: 118°E – 128°E</div>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="button"
                                                class="btn btn-outline-secondary w-100"
                                                data-call="useCurrentLocation"
                                                title="Use device GPS">
                                            <i class="ph ph-crosshair"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Live map preview -->
                                <div id="geoTagMapPreview" class="geo-preview-map mb-3"
                                     style="<%= !applicant.latitude ? 'display:none' : '' %>">
                                </div>

                                <div class="d-flex gap-2 align-items-center">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="ph-fill ph-map-pin me-2"></i>Save Geo-Tag
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-call="hideGeoPanel">
                                        Cancel
                                    </button>
                                    <small class="text-muted ms-2">
                                        <i class="ph ph-info me-1"></i>
                                        This will advance the application to Step 5 — Field Validation
                                    </small>
                                </div>
                            </form>
                        </div>
                        <% } %>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<%
// These locals arrive from routes/applicants.js. Guard them so that a caller
// that has not been updated — or a stale server still running older route code
// — degrades to hiding this section instead of failing the whole page with a
// ReferenceError. EJS re-reads templates from disk in development, so the view
// and the route can briefly disagree after an edit until the server restarts.
var _facilities      = typeof facilities      !== 'undefined' && facilities      ? facilities      : [];
var _facilityStatus  = typeof facilityStatus  !== 'undefined' && facilityStatus  ? facilityStatus  : {};
var _fieldValidation = typeof fieldValidation !== 'undefined' && fieldValidation ? fieldValidation : [];
var _selfAssessment  = typeof selfAssessment  !== 'undefined' && selfAssessment  ? selfAssessment  : [];
var _areaCheck       = typeof areaCheck       !== 'undefined' && areaCheck       ? areaCheck       : null;
%>
<div class="page-container pt-0">

    <!-- Basic facilities required by the LSA guidelines (PDF p.11). Two columns:
         what the applicant claimed in step 2, and what the TWG saw in step 5.
         Hidden entirely when the checklist definitions are unavailable. -->
    <!-- LSA-10 — operator qualifications. The RSBSA number is a stored field;
         the rest are the operator answers from the Step 2 self-assessment, which
         are kept per item rather than collapsed into a score. -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h6 class="mb-0"><i class="ph ph-identification-card me-2"></i>Operator Qualifications</h6>
                <% var _ops = _selfAssessment.filter(function (r) { return r.category === 'Operator'; }); %>
                <% if (_ops.length) { %>
                <span class="small text-muted"><%= _ops.filter(function (r) { return r.answer === 1; }).length %> of <%= _ops.length %> met</span>
                <% } %>
            </div>
            <div class="detail-info-item mb-2">
                <i class="ph ph-list-bullets"></i>
                <span>
                    RSBSA / NCFRS:
                    <% if (applicant.rsbsaNumber) { %>
                    <strong><%= applicant.rsbsaNumber %></strong>
                    <% } else { %>
                    <span class="text-warning">not recorded</span>
                    <% } %>
                </span>
            </div>
            <% if (_ops.length) { %>
            <ul class="list-unstyled small mb-0">
                <% _ops.forEach(function (r) { %>
                <li class="mb-1 d-flex gap-2">
                    <% if (r.answer === 1) { %>
                    <i class="ph-fill ph-check-circle text-success flex-shrink-0"></i>
                    <% } else { %>
                    <i class="ph ph-x-circle text-danger flex-shrink-0"></i>
                    <% } %>
                    <span><%= r.label %></span>
                </li>
                <% }); %>
            </ul>
            <% } else { %>
            <p class="small text-muted mb-0">
                The Step 2 self-assessment has not been submitted, so the operator
                qualifications have not been answered yet.
            </p>
            <% } %>
            <p class="small text-secondary mb-0 mt-2">
                <i class="ph ph-notebook me-1"></i><em>LSA Guidelines — Qualification Requirements, The Operator.</em>
            </p>
        </div>
    </div>

    <!-- LSA-20 — the disqualification declaration. NULL means never asked,
         which is not the same as declared eligible. -->
    <div class="card mb-4">
        <div class="card-body d-flex align-items-start gap-3">
            <i class="ph ph-identification-badge fs-4 text-<%= applicant.notDisqualified === 1 ? 'success' : 'secondary' %>"></i>
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-1">Disqualification Declaration</h6>
                    <% if (applicant.notDisqualified === 1) { %>
                    <span class="badge bg-success-subtle text-success">Declared eligible</span>
                    <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Not declared</span>
                    <% } %>
                </div>
                <p class="small text-muted mb-1">
                    <% if (applicant.notDisqualified === 1) { %>
                        Declared on <strong><%= applicant.disqualificationDeclaredAt || applicant.step1_brieferDate %></strong>
                        that they are none of the disqualified persons named in the briefer.
                    <% } else { %>
                        This applicant has not answered the disqualification question. Applications
                        signed before the declaration was recorded will show this.
                    <% } %>
                </p>
                <p class="small text-secondary mb-0">
                    <i class="ph ph-notebook me-1"></i><em>LSA Briefer — Disqualified persons:</em>
                    public officials and employees, their spouses, and their unmarried children under 18.
                </p>
            </div>
        </div>
    </div>

    <!-- LSA-08 — minimum farm area. Stated in the briefer for years but never
         actually compared against the recorded area until now. -->
    <% if (_areaCheck) { %>
    <div class="card mb-4">
        <div class="card-body d-flex align-items-start gap-3">
            <i class="ph ph-ruler fs-4 text-<%= _areaCheck.meets === false ? 'danger' : _areaCheck.meets === null ? 'secondary' : 'success' %>"></i>
            <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-1">Farm Area Requirement</h6>
                    <% if (_areaCheck.meets === true) { %>
                    <span class="badge bg-success-subtle text-success">Meets requirement</span>
                    <% } else if (_areaCheck.meets === false) { %>
                    <span class="badge bg-danger-subtle text-danger">Below minimum</span>
                    <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Not recorded</span>
                    <% } %>
                </div>
                <p class="small text-muted mb-1">
                    <% if (_areaCheck.area === null) { %>
                        No farm area has been recorded for this application.
                    <% } else { %>
                        Recorded area <strong><%= _areaCheck.area.toLocaleString() %> sq.m.</strong><% if (_areaCheck.minimum > 0) { %>,
                        against a minimum of <strong><%= _areaCheck.minimum.toLocaleString() %> sq.m.</strong><% } %>
                        <% if (_areaCheck.meets === false) { %>
                        — short by <strong><%= _areaCheck.shortfall.toLocaleString() %> sq.m.</strong>
                        <% } %>
                    <% } %>
                </p>
                <p class="small text-secondary mb-0">
                    <i class="ph ph-notebook me-1"></i><em>LSA Briefer — Farm Requirements.</em>
                    <%= _areaCheck.rule %>
                </p>
            </div>
        </div>
    </div>
    <% } %>

    <% if (_facilities.length) { %>
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-1"><i class="ph ph-buildings me-2"></i>Basic Facilities</h5>
            <p class="small text-muted mb-3">
                Required of every Learning Site — <em>LSA Guidelines, Farm Requirements</em>.
                Declared by the applicant in the self-assessment, confirmed by the TWG on site.
            </p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Facility</th>
                            <th class="text-center">Declared (Step 2)</th>
                            <th class="text-center">Verified on site (Step 5)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% _facilities.forEach(function (f) {
                             var st = _facilityStatus[f.key] || {}; %>
                        <tr>
                            <td><%= f.label %></td>
                            <td class="text-center">
                                <% if (st.claimed === true) { %><span class="badge bg-success-subtle text-success">Yes</span>
                                <% } else if (st.claimed === false) { %><span class="badge bg-danger-subtle text-danger">No</span>
                                <% } else { %><span class="text-muted small">Not assessed</span><% } %>
                            </td>
                            <td class="text-center">
                                <% if (st.verified === true) { %><span class="badge bg-success-subtle text-success">Confirmed</span>
                                <% } else if (st.verified === false) { %><span class="badge bg-danger-subtle text-danger">Not present</span>
                                <% } else { %><span class="text-muted small">Not yet validated</span><% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% var anyDiscrepancy = _facilities.some(function (f) {
                 var st = _facilityStatus[f.key] || {};
                 return st.claimed === true && st.verified === false;
               }); %>
            <% if (anyDiscrepancy) { %>
            <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small">
                <i class="ph ph-warning me-1"></i>
                One or more facilities were declared by the applicant but not found during field validation.
            </div>
            <% } %>
        </div>
    </div>

    <% } %>

    <!-- Field Validation Report — the per-item result of the TWG site visit. -->
    <% if (_fieldValidation.length) { %>
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <h5 class="card-title mb-0"><i class="ph ph-clipboard-text me-2"></i>Field Validation Report</h5>
                <span class="small text-muted">
                    <%= applicant.step5_validationType || 'Field' %> validation
                    <% if (applicant.step5_validationDate) { %> · <%= applicant.step5_validationDate %><% } %>
                </span>
            </div>
            <p class="small text-muted mb-3">
                Recorded by <%= _fieldValidation[0].recordedBy || applicant.step5_inspectedBy || 'the TWG' %>.
                <%= _fieldValidation.filter(function (r) { return r.answer === 1; }).length %>
                of <%= _fieldValidation.length %> items met.
            </p>
            <ul class="list-group list-group-flush">
                <% _fieldValidation.forEach(function (r) { %>
                <li class="list-group-item d-flex justify-content-between align-items-start gap-3 px-0">
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary me-2"><%= r.category %></span>
                        <%= r.label %>
                    </div>
                    <span class="flex-shrink-0">
                        <% if (r.answer === 1) { %>
                        <i class="ph-fill ph-check-circle text-success"></i>
                        <% } else { %>
                        <i class="ph-fill ph-x-circle text-danger"></i>
                        <% } %>
                    </span>
                </li>
                <% }); %>
            </ul>
            <% if (applicant.step5_twgRemarks) { %>
            <div class="mt-3 small">
                <strong>TWG remarks:</strong> <%= applicant.step5_twgRemarks %>
            </div>
            <% } %>
        </div>
    </div>
    <% } else if (applicant.step5_validationDate) { %>
    <div class="alert alert-secondary small">
        <i class="ph ph-info me-1"></i>
        This field validation was recorded before individual results were kept, so only the
        summary (<%= applicant.step5_checkedItems %> items met) is available.
    </div>
    <% } %>

    <!-- Self-assessment detail, for the evaluator reviewing the claim. -->
    <% if (_selfAssessment.length && ['admin'].includes(role)) { %>
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-1"><i class="ph ph-user-check me-2"></i>Self-Assessment Detail</h5>
            <p class="small text-muted mb-3">
                What the applicant declared in Step 2 — score <%= applicant.step2_selfAssessmentScore %>%.
            </p>
            <div class="row g-3">
                <% ['Farm','Operator','Documents'].forEach(function (cat) {
                     var items = _selfAssessment.filter(function (r) { return r.category === cat; });
                     if (!items.length) return; %>
                <div class="col-md-4">
                    <h6 class="small text-uppercase text-muted"><%= cat %></h6>
                    <ul class="list-unstyled small mb-0">
                        <% items.forEach(function (r) { %>
                        <li class="mb-1 d-flex gap-2">
                            <% if (r.answer === 1) { %>
                            <i class="ph-fill ph-check-circle text-success flex-shrink-0"></i>
                            <% } else { %>
                            <i class="ph ph-x-circle text-danger flex-shrink-0"></i>
                            <% } %>
                            <span><%= r.label %></span>
                        </li>
                        <% }); %>
                    </ul>
                </div>
                <% }); %>
            </div>
        </div>
    </div>
    <% } %>

</div>

<%- include('../partials/footer') %>
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<%- include('../partials/scripts') %>
<%- include('../partials/chatbot') %>

<script nonce="<%= cspNonce %>">
// Geo-tag panel show/hide — named so the buttons can use data-call instead of
// inline onclick (the CSP forbids inline handlers). Dispatched by actions.js.
function toggleGeoPanel() {
    document.getElementById('geoTagPanel').classList.toggle('d-none');
}
function hideGeoPanel() {
    document.getElementById('geoTagPanel').classList.add('d-none');
}
function recordLocationNow(btn) {
    document.getElementById('geoTagPanel').classList.remove('d-none');
    const placeholder = btn && btn.closest('.geo-pending-placeholder');
    if (placeholder) placeholder.style.opacity = '0.5';
}

// ── Read geo data from server ─────────────────────────────────
const farmLat    = <%= applicant.latitude  || 'null' %>;
const farmLng    = <%= applicant.longitude || 'null' %>;
const farmName   = "<%= applicant.farmName.replace(/"/g,'') %>";
const farmAddr   = "<%= applicant.farmAddress.replace(/"/g,'') %>";
const geoTagged  = <%= applicant.geoTagStatus === 'tagged' ? 'true' : 'false' %>;

// ── Main farm map (if already tagged) ────────────────────────
if (farmLat && farmLng) {
    const map = L.map('farmMap').setView([farmLat, farmLng], 14);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/">OpenStreetMap</a>',
        maxZoom: 19
    }).addTo(map);

    // Custom marker icon
    const markerIcon = L.divIcon({
        html: `<div class="map-marker-pin">
                 <i class="ph-fill ph-map-pin"></i>
               </div>`,
        className: '',
        iconSize: [32, 40],
        iconAnchor: [16, 40],
        popupAnchor: [0, -40]
    });

    L.marker([farmLat, farmLng], { icon: markerIcon })
        .addTo(map)
        .bindPopup(`
            <div class="map-popup">
                <strong>${farmName}</strong><br>
                <span class="text-muted">${farmAddr}</span><br>
                <small>📍 ${farmLat.toFixed(4)}°N, ${farmLng.toFixed(4)}°E</small>
            </div>
        `)
        .openPopup();
}

// ── Preview map in geo-tag form ───────────────────────────────
let previewMap = null;
let previewMarker = null;

function updateMapPreview() {
    const lat = parseFloat(document.getElementById('latInput').value);
    const lng = parseFloat(document.getElementById('lngInput').value);
    const preview = document.getElementById('geoTagMapPreview');

    if (isNaN(lat) || isNaN(lng)) return;
    if (lat < 10 || lat > 20 || lng < 118 || lng > 128) return;

    preview.style.display = 'block';

    if (!previewMap) {
        previewMap = L.map('geoTagMapPreview').setView([lat, lng], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap', maxZoom: 19
        }).addTo(previewMap);
    } else {
        previewMap.setView([lat, lng], 13);
    }

    if (previewMarker) previewMap.removeLayer(previewMarker);
    previewMarker = L.marker([lat, lng])
        .addTo(previewMap)
        .bindPopup(`<strong>${farmName}</strong><br>${lat.toFixed(4)}°N, ${lng.toFixed(4)}°E`)
        .openPopup();
}

// ── Use device GPS ────────────────────────────────────────────
function useCurrentLocation() {
    if (!navigator.geolocation) {
        alert('Geolocation is not supported by this browser.');
        return;
    }
    const btn = event.currentTarget;
    btn.innerHTML = '<i class="ph ph-arrow-clockwise spin"></i>';
    btn.disabled  = true;

    navigator.geolocation.getCurrentPosition(
        (pos) => {
            document.getElementById('latInput').value = pos.coords.latitude.toFixed(4);
            document.getElementById('lngInput').value = pos.coords.longitude.toFixed(4);
            updateMapPreview();
            btn.innerHTML = '<i class="ph ph-check-circle text-success"></i>';
            btn.disabled  = false;
        },
        (err) => {
            alert('Could not get location: ' + err.message);
            btn.innerHTML = '<i class="ph ph-crosshair"></i>';
            btn.disabled  = false;
        },
        { enableHighAccuracy: true, timeout: 10000 }
    );
}

// ── Init preview map if coords already present ────────────────
document.addEventListener('DOMContentLoaded', () => {
    const lat = document.getElementById('latInput');
    const lng = document.getElementById('lngInput');
    if (lat && lng && lat.value && lng.value) updateMapPreview();
});
</script>
</body>
</html>
