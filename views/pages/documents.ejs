<%- include('../partials/header') %>
<%- include('../partials/navbar', { page }) %>

<div class="main-wrapper">
    <div class="page-content">

        <div class="page-header">
            <div>
                <h1 class="page-title">Document Management</h1>
                <p class="page-subtitle">Document verification and tracking</p>
            </div>
            <a href="/documents/submit" class="btn btn-primary">
                <i class="bi bi-upload me-2"></i>Submit Document
            </a>
        </div>

        <!-- Success -->
        <% if (filters.success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="bi bi-check-circle me-2"></i><%
                if (filters.success === 'replaced') { %>Document replaced — the previous file for this requirement was removed.<%
                } else if (filters.success === 'accepted') { %>Document accepted. The applicant has been notified.<%
                } else if (filters.success === 'rejected') { %>Document marked for revision. The applicant has been notified with your remarks.<%
                } else { %>Document submitted successfully.<% } %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <% if (filters.error === 'review') { %>
        <div class="alert alert-warning alert-dismissible fade show mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i>Rejecting a document needs a reason — the applicant has to be told what to fix.
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <!-- Stat Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary"><i class="bi bi-files"></i></div>
                    <div class="stat-info"><h3><%= docStats.total %></h3><p>Total Documents</p></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success"><i class="bi bi-patch-check"></i></div>
                    <div class="stat-info"><h3><%= docStats.verified %></h3><p>Verified</p></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-warning"><i class="bi bi-hourglass-split"></i></div>
                    <div class="stat-info"><h3><%= docStats.pending %></h3><p>Pending Review</p></div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="stat-card">
                    <div class="stat-icon bg-danger"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="stat-info"><h3><%= docStats.incomplete %></h3><p>Incomplete</p></div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-4 p-3">
            <form method="GET" action="/documents" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="search" class="form-label small fw-semibold">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="search" type="text" class="form-control" name="search"
                               placeholder="Document name or applicant..."
                               value="<%= filters.search || '' %>">
                    </div>
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label small fw-semibold">Status</label>
                    <select id="status" class="form-select" name="status">
                        <option value="">All Statuses</option>
                        <option value="verified"      <%= filters.status==='verified'      ?'selected':'' %>>Verified</option>
                        <option value="pending_review"<%= filters.status==='pending_review'?'selected':'' %>>Pending Review</option>
                        <option value="incomplete"    <%= filters.status==='incomplete'    ?'selected':'' %>>Incomplete</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="/documents" class="btn btn-outline-secondary w-100">Reset</a>
                </div>
            </form>
        </div>

        <!-- Documents grouped by requirement: one container per document type,
             holding every applicant's submission of it. -->
        <% if (docGroups.length === 0) { %>
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                No documents found.
            </div>
        </div>
        <% } else { %>
        <% docGroups.forEach((g) => { %>
        <section class="doc-type">
            <header class="doc-type__head">
                <span class="doc-type__icon"><i class="bi bi-folder2-open"></i></span>
                <div class="doc-type__title">
                    <h2><%= g.label %></h2>
                    <% if (g.form) { %><span class="doc-type__form"><%= g.form %></span><% } %>
                </div>
                <div class="doc-type__counts">
                    <span class="doc-type__total"><%= g.counts.total %> submitted</span>
                    <% if (g.counts.verified) { %><span class="status-badge verified"><%= g.counts.verified %> verified</span><% } %>
                    <% if (g.counts.pending) { %><span class="status-badge pending_review"><%= g.counts.pending %> pending</span><% } %>
                    <% if (g.counts.incomplete) { %><span class="status-badge incomplete"><%= g.counts.incomplete %> to fix</span><% } %>
                </div>
            </header>

            <div class="doc-type__items">
                <% g.items.forEach((d) => { %>
                <article class="doc-item doc-item--<%= d.status %>">
                    <div class="doc-item__head">
                        <div class="doc-item__who">
                            <span class="doc-item__applicant"><%= d.applicantName %></span>
                            <span class="app-id-link"><%= d.applicationId %></span>
                        </div>
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="status-badge <%= d.status %>"><%= d.status.replace(/_/g,' ') %></span>
                            <button type="button" class="btn btn-sm btn-link p-0 text-secondary doc-history-btn"
                                    data-doc-id="<%= d.id %>" data-doc-name="<%= d.name %>"
                                    title="Submission &amp; validation history">
                                <i class="bi bi-clock-history"></i>
                            </button>
                        </span>
                    </div>

                    <div class="doc-item__meta">
                        <span class="doc-item__file">
                            <i class="bi bi-paperclip"></i>
                            <% if (d.storedName) { %>
                            <a href="/documents/<%= d.id %>/file" target="_blank"><%= d.filename %></a>
                            <% } else { %>
                            <span class="text-muted"><%= d.filename %></span>
                            <% } %>
                        </span>
                        <span class="doc-item__size"><%= d.size %></span>
                        <span class="doc-item__date"><i class="bi bi-calendar3 me-1"></i><%= d.uploadDate || '—' %></span>
                    </div>

                    <% if (d.remarks || d.reviewedByName) { %>
                    <div class="doc-item__remarks">
                        <% if (d.remarks) { %><span><%= d.remarks %></span><% } %>
                        <% if (d.reviewedByName) { %><span class="doc-item__reviewer">reviewed by <%= d.reviewedByName %></span><% } %>
                    </div>
                    <% } %>

                    <% if (!canReview && d.status === 'incomplete') { %>
                    <a class="doc-item__resubmit"
                       href="/documents/submit?type=<%= encodeURIComponent(d.type) %>&applicant=<%= d.applicantId %>&resubmit=1">
                        <i class="bi bi-arrow-repeat me-1"></i>Re-submit
                    </a>
                    <% } %>

                    <% if (canReview && d.status === 'verified') { %>
                    <div class="doc-item__actions">
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                            <i class="bi bi-check-circle me-1"></i>Accepted
                        </span>
                    </div>
                    <% } else if (canReview) { %>
                    <form action="/documents/<%= d.id %>/review" method="POST" class="doc-item__review">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <label class="visually-hidden" for="remarks<%= d.id %>">Remarks for <%= d.name %> — <%= d.applicantName %></label>
                        <input type="text" class="form-control form-control-sm"
                               id="remarks<%= d.id %>" name="remarks"
                               value="<%= d.status === 'incomplete' ? (d.remarks || '') : '' %>"
                               placeholder="Reason (required to reject)">
                        <div class="doc-item__actions">
                            <button type="submit" name="status" value="verified"
                                    class="btn btn-sm btn-success" title="Accept this document">
                                <i class="bi bi-check-lg me-1"></i>Accept
                            </button>
                            <button type="submit" name="status" value="incomplete"
                                    class="btn btn-sm btn-outline-danger" title="Reject — a reason is required">
                                <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                        </div>
                    </form>
                    <% } %>
                </article>
                <% }) %>
            </div>
        </section>
        <% }) %>
        <% } %>

    </div>
</div>

<!-- Document submission & validation history -->
<div class="modal fade" id="docHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clock-history me-2"></i>Document History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="docHistoryBody">
                <div class="text-muted">Loading&hellip;</div>
            </div>
        </div>
    </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
    var modalEl = document.getElementById('docHistoryModal');
    if (!modalEl || typeof bootstrap === 'undefined') return;
    var body = document.getElementById('docHistoryBody');
    var titleEl = modalEl.querySelector('.modal-title');
    var modal = new bootstrap.Modal(modalEl);
    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function fmt(ts) { try { return new Date(ts).toLocaleString('en-PH', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch (e) { return esc(ts); } }
    function badge(a) {
        if (a === 'accepted') return '<span class="status-badge verified">accepted</span>';
        if (a === 'rejected') return '<span class="status-badge incomplete">rejected</span>';
        return '<span class="status-badge pending_review">submitted</span>';
    }
    document.querySelectorAll('.doc-history-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id = btn.getAttribute('data-doc-id');
            titleEl.innerHTML = '<i class="bi bi-clock-history me-2"></i>History &mdash; ' + esc(btn.getAttribute('data-doc-name') || 'Document');
            body.innerHTML = '<div class="text-muted">Loading&hellip;</div>';
            modal.show();
            fetch('/documents/' + id + '/history', { headers: { Accept: 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (!j.success || !j.events || !j.events.length) {
                        body.innerHTML = '<div class="text-muted">No history recorded yet.</div>'; return;
                    }
                    var attempt = 0, html = '<ol class="list-unstyled mb-0">';
                    j.events.forEach(function (e) {
                        if (e.action === 'submitted') attempt += 1;
                        var head = e.action === 'submitted' ? ('Attempt ' + attempt) : (e.action.charAt(0).toUpperCase() + e.action.slice(1));
                        html += '<li class="mb-3 pb-2 border-bottom">'
                            + '<div class="d-flex justify-content-between align-items-center gap-2"><strong>' + esc(head) + '</strong>' + badge(e.action) + '</div>'
                            + '<div class="small text-muted">' + fmt(e.createdAt) + (e.actor ? ' &middot; ' + esc(e.actor) : '') + '</div>'
                            + (e.remarks ? '<div class="small">Reason: ' + esc(e.remarks) + '</div>' : '')
                            + '</li>';
                    });
                    body.innerHTML = html + '</ol>';
                })
                .catch(function () { body.innerHTML = '<div class="text-danger">Could not load history.</div>'; });
        });
    });
})();
</script>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<%- include('../partials/chatbot') %>
</body>
</html>
