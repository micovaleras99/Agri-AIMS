<%- include('../../partials/header') %>
<%- include('../../partials/navbar', { page, currentUser, role }) %>

<div class="main-wrapper">
<div class="page-content">

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/applicants">Applications</a></li>
        <li class="breadcrumb-item"><a href="/accreditation/<%= applicant.id %>"><%= applicant.applicationId %></a></li>
        <li class="breadcrumb-item active">Step 2: Self-Assessment</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <span class="step-badge bg-info">Step 2 of 7</span>
        <h1 class="page-title mt-1">Self-Assessment</h1>
        <p class="page-subtitle">Eligibility self-assessment · <strong>ATI-QF/PAD-164 Rev. 00</strong></p>
    </div>
    <div class="d-flex gap-2">
        <% if (applicant.step2_completedDate) { %>
        <span class="badge bg-success px-3 py-2">
            <i class="bi bi-clipboard-check me-1"></i>Submitted
        </span>
        <% } %>
        <a href="/accreditation/<%= applicant.id %>" class="btn btn-outline-secondary">Overview</a>
    </div>
</div>

<% if (applicant.step2_completedDate && submitted) { %>
<div class="alert alert-success mb-4 d-flex flex-wrap align-items-center gap-2">
    <i class="bi bi-check-circle-fill me-1"></i>
    <span>Self-assessment submitted on <strong><%= applicant.step2_completedDate %></strong>. The system
        filled the official form from your answers.</span>
    <a href="/forms/self_assessment/download?applicant=<%= applicant.id %>"
       class="btn btn-sm btn-outline-success">
        <i class="bi bi-file-earmark-word me-1"></i>Preview / Download form
    </a>
    <% if (!readonly) { %>
    <form action="/forms/self_assessment/regenerate" method="POST" class="d-inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="applicant" value="<%= applicant.id %>">
        <button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-repeat me-1"></i>Regenerate
        </button>
    </form>
    <% } %>
    <a href="/accreditation/<%= applicant.id %>/step/3" class="btn btn-sm btn-success ms-auto">
        Continue to Step 3 →
    </a>
</div>
<% } %>

<div class="row g-4">
    <div class="col-lg-8">

        <div class="card mb-4">
            <div class="card-body p-4">
                <h5 class="section-title mb-2">
                    <i class="bi bi-clipboard-check me-2 text-info"></i>Eligibility Checklist
                    (<%= section.title %>)
                </h5>
                <p class="text-muted">
                    Tick every item your <%= section.key === 'agri' ? 'enterprise' : 'farm' %> meets.
                    The system writes your answers and your saved details straight into the official
                    Self-Assessment Word form — you don't download, print or upload anything.
                </p>

                <% if (missing && missing.length) { %>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Some required information is missing, so the form can't be completed yet. Please
                    add the following to the application first:
                    <ul class="mb-0 mt-1"><% missing.forEach(function (m) { %><li><%= m %></li><% }); %></ul>
                </div>
                <% } %>

                <% if (typeof certError !== 'undefined' && certError) { %>
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Please tick the certification box to confirm your answers before submitting.
                </div>
                <% } %>

                <% if (typeof regenerated !== 'undefined' && regenerated) { %>
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>The form was regenerated from your latest information.
                </div>
                <% } %>

                <form action="/accreditation/<%= applicant.id %>/step/2" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <% const locked = readonly || applicant.step2_completedDate; %>

                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="establishedDate">
                            Date Established <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control" id="establishedDate" name="establishedDate"
                               value="<%= establishedDate %>" <%= locked ? 'disabled' : '' %>>
                        <div class="form-text">
                            When the farm / agri-processing enterprise was established. This appears on the
                            official Self-Assessment form.
                        </div>
                    </div>

                    <fieldset class="mb-4">
                        <% section.rows.forEach(function (row) { %>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" value="on"
                                   id="<%= row.code %>" name="<%= row.code %>"
                                   <%= answers[row.code] ? 'checked' : '' %>
                                   <%= locked ? 'disabled' : '' %>>
                            <label class="form-check-label" for="<%= row.code %>">
                                <%= labels[row.code] || row.locate %>
                            </label>
                        </div>
                        <% }); %>
                    </fieldset>

                    <div class="mb-3">
                        <label class="form-label" for="saRemarks">Remarks (optional)</label>
                        <textarea class="form-control" id="saRemarks" name="remarks" rows="3"
                                  placeholder="Any notes about your farm or situation..."
                                  <%= locked ? 'disabled' : '' %>><%= applicant.step2_remarks || '' %></textarea>
                    </div>

                    <% if (!locked) { %>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="1" id="certify" name="certify">
                        <label class="form-check-label" for="certify">
                            I certify that the information above is true and correct to the best of my knowledge.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-info text-white btn-lg">
                        <i class="bi bi-clipboard-check me-2"></i>Submit Self-Assessment &amp; Proceed to Step 3
                    </button>
                    <% } else if (applicant.step2_completedDate) { %>
                    <p class="text-muted mb-0">
                        <i class="bi bi-info-circle me-1"></i>Your self-assessment has been submitted.
                        Use <strong>Preview / Download form</strong> above to open the completed Word document.
                    </p>
                    <% } %>
                </form>
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <%- include('../../partials/acred-sidebar', { applicant, currentStep: 2 }) %>
    </div>
</div>

</div>
</div>

<%- include('../../partials/footer') %>
<%- include('../../partials/scripts') %>
</body>
</html>
