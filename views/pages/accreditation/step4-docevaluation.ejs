<%- include('../../partials/header') %>
<%- include('../../partials/navbar', { page, currentUser, role }) %>

<div class="main-wrapper">
<div class="page-content">

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/applicants">Applications</a></li>
        <li class="breadcrumb-item"><a href="/accreditation/<%= applicant.id %>"><%= applicant.applicationId %></a></li>
        <li class="breadcrumb-item active">Step 4: Document Evaluation</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <span class="step-badge" style="background:#e67e22;color:#fff;">Step 4 of 7</span>
        <h1 class="page-title mt-1">Document Evaluation</h1>
        <p class="page-subtitle">Review submitted documents for completeness and legibility</p>
    </div>
    <a href="/accreditation/<%= applicant.id %>" class="btn btn-outline-secondary">Overview</a>
</div>

<% if (evalResult === 'passed') { %>
<div class="alert alert-success mb-4">
    <i class="ph-fill ph-check-circle me-2"></i>Documents passed evaluation by <strong><%= applicant.step4_evalBy %></strong>
    on <strong><%= applicant.step4_evalDate %></strong>. Proceeding to field validation.
</div>
<% } %>

<div class="row g-4">
    <div class="col-lg-8">

        <!-- Documents table -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="card-header-row mb-3">
                    <h5 class="card-title mb-0">
                        <i class="ph ph-folder me-2 text-warning"></i>Submitted Documents
                    </h5>
                    <a href="/documents?search=<%= applicant.applicationId %>" class="btn btn-sm btn-outline-primary">All Docs</a>
                </div>
                <% if (myDocs.length === 0) { %>
                <div class="text-center py-4 text-muted">
                    <i class="ph ph-folder-minus fs-1 d-block mb-2"></i>No documents submitted yet.
                </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 table-sm">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Uploaded</th>
                                <th>Size</th>
                                <th>Status</th>
                                <th>Remarks</th>
                                <th class="text-end">Decision</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% myDocs.forEach(d => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="ph ph-file-pdf text-danger"></i>
                                    <a href="/documents/<%= d.id %>/file" target="_blank" rel="noopener"
                                       class="fw-semibold small text-decoration-none" title="Open the uploaded file">
                                        <%= d.name %>
                                    </a>
                                </div>
                                <% if (d.filename) { %>
                                <a href="/documents/<%= d.id %>/file" target="_blank" rel="noopener"
                                   class="text-muted d-inline-flex align-items-center gap-1" style="font-size:11px">
                                    <i class="ph ph-paperclip"></i><%= d.filename %>
                                </a>
                                <% } %>
                            </td>
                            <td class="text-muted small"><%= d.uploadDate %></td>
                            <td class="text-muted small"><%= d.size %></td>
                            <td>
                                <span class="status-badge <%= d.status %>"><%= d.status.replace(/_/g, ' ') %></span>
                                <% if (d.reviewedByName) { %>
                                <div class="text-muted" style="font-size:11px">
                                    <%= d.reviewedByName %><% if (d.reviewedAt) { %> · <%= new Date(d.reviewedAt).toISOString().split('T')[0] %><% } %>
                                </div>
                                <% } %>
                            </td>
                            <td class="text-muted small" style="max-width:220px"><%= d.remarks || '—' %></td>
                            <td class="text-end">
                                <% if (d.status === 'verified') { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="ph ph-check-circle me-1"></i>Accepted
                                </span>
                                <% } else { %>
                                <form action="/documents/<%= d.id %>/review" method="POST" class="d-flex gap-1 justify-content-end">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="back" value="step4">
                                    <label class="visually-hidden" for="remarks<%= d.id %>">Remarks for <%= d.name %></label>
                                    <input type="text" class="form-control form-control-sm" style="max-width:180px"
                                           id="remarks<%= d.id %>" name="remarks" value="<%= d.remarks || '' %>"
                                           placeholder="Reason (required to reject)">
                                    <button type="submit" name="status" value="verified"
                                            class="btn btn-sm btn-success" title="Accept this document">
                                        <i class="ph ph-check"></i><span class="visually-hidden">Accept</span>
                                    </button>
                                    <button type="submit" name="status" value="incomplete"
                                            class="btn btn-sm btn-outline-danger" title="Reject — a reason is required">
                                        <i class="ph ph-x"></i><span class="visually-hidden">Reject</span>
                                    </button>
                                </form>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>

        <% if (blocked) { %>
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="ph ph-shield-warning me-2"></i><%= passGate.reason || 'Every document must be accepted before this step can be passed.' %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        <% } %>

        <!-- Evaluation Decision Form -->
        <% if (!evalResult) { %>
        <div class="card">
            <div class="card-body p-4">
                <h5 class="card-title mb-4">
                    <i class="ph ph-clipboard-text me-2 text-warning"></i>Evaluation Decision
                </h5>
                <form action="/accreditation/<%= applicant.id %>/step/4" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-4">
                        <label for="evalRemarks" class="form-label fw-semibold">Evaluation Remarks</label>
                        <textarea id="evalRemarks" class="form-control" name="evalRemarks" rows="3"
                                  placeholder="Notes on document completeness and legibility..."></textarea>
                    </div>
                    <% if (!passGate.ok) { %>
                    <div class="alert alert-warning d-flex align-items-start gap-2">
                        <i class="ph ph-warning mt-1"></i>
                        <div>
                            <strong>This step cannot be passed yet.</strong>
                            <div class="small"><%= passGate.reason %> Use the Accept and Reject buttons on each document above.</div>
                        </div>
                    </div>
                    <% } %>
                    <div class="d-flex gap-3">
                        <button type="submit" name="evalResult" value="passed"
                                class="btn btn-success"
                                <%= passGate.ok ? '' : 'disabled' %>
                                <% if (!passGate.ok) { %>title="<%= passGate.reason %>"<% } %>>
                            <i class="ph ph-check-circle me-2"></i>Pass — Proceed to Field Validation
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>

    </div>
    <div class="col-lg-4">
        <%- include('../../partials/acred-sidebar', { applicant, currentStep: 4 }) %>
    </div>
</div>

</div>
</div>

<%- include('../../partials/footer') %>
<%- include('../../partials/scripts') %>
</body>
</html>
