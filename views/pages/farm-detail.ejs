<%- include('../partials/header') %>
<%- include('../partials/navbar', { page }) %>

<div class="main-wrapper">
    <div class="page-content">

        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/farms">Farms</a></li>
                <li class="breadcrumb-item active"><%= farm.name %></li>
            </ol>
        </nav>

        <div class="row g-4">

            <!-- Left column -->
            <div class="col-lg-4">
                <div class="card mb-4 p-4 text-center">
                    <div class="farm-detail-icon mb-3">
                        <i class="bi bi-tree"></i>
                    </div>
                    <h4><%= farm.name %></h4>
                    <p class="text-muted mb-2"><%= farm.operator %></p>
                    <span class="badge bg-success px-3 py-2 mb-3"><%= farm.accreditationLevel %></span>

                    <div class="detail-info-list text-start mt-2">
                        <div class="detail-info-item">
                            <i class="bi bi-geo-alt"></i>
                            <span><%= farm.municipality %>, <%= farm.province %></span>
                        </div>
                        <div class="detail-info-item">
                            <i class="bi bi-tag"></i>
                            <span><%= classificationLabel(farm.classification) %></span>
                        </div>
                        <div class="detail-info-item">
                            <i class="bi bi-award"></i>
                            <span><%= farm.lsaType %></span>
                        </div>
                        <div class="detail-info-item">
                            <i class="bi bi-rulers"></i>
                            <span><%= farm.farmArea.toLocaleString() %> sq.m.</span>
                        </div>
                        <div class="detail-info-item">
                            <i class="bi bi-calendar-check"></i>
                            <span>Since <%= farm.accreditedSince %></span>
                        </div>
                        <div class="detail-info-item">
                            <i class="bi bi-calendar-x"></i>
                            <span>Expires <%= farm.expiryDate %></span>
                        </div>
                    </div>
                </div>

                <!-- Performance Cards -->
                <div class="row g-3">
                    <div class="col-6">
                        <div class="mini-stat-card">
                            <i class="bi bi-people text-info"></i>
                            <h4><%= farm.visitorsThisYear %></h4>
                            <small>Visitors</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="mini-stat-card">
                            <i class="bi bi-mortarboard text-success"></i>
                            <h4><%= farm.trainingSessions %></h4>
                            <small>Trainings</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right column -->
            <div class="col-lg-8">

                <!-- Compliance -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">
                            <i class="bi bi-shield-check me-2 text-success"></i>Compliance Status
                        </h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="fw-semibold">Overall Compliance Score</span>
                            <% if (!compliance.assessed) { %>
                            <span class="fw-bold text-muted">Not yet assessed</span>
                            <% } else { %>
                            <span class="fw-bold fs-5
                                <% if (compliance.score >= 80) { %>text-success
                                <% } else if (compliance.score >= 60) { %>text-warning
                                <% } else { %>text-danger<% } %>">
                                <%= compliance.score %>%
                            </span>
                            <% } %>
                        </div>
                        <% if (compliance.assessed) { %>
                        <div class="progress mb-3" style="height:14px; border-radius:7px;">
                            <div class="progress-bar
                                <% if (compliance.score >= 80) { %>bg-success
                                <% } else if (compliance.score >= 60) { %>bg-warning
                                <% } else { %>bg-danger<% } %>"
                                style="width:<%= compliance.score %>%">
                                <%= compliance.score %>%
                            </div>
                        </div>
                        <% } else { %>
                        <p class="text-muted small mb-3">
                            No compliance check has been recorded against this farm's
                            <%= compliance.applicable %> requirements yet.
                        </p>
                        <% } %>
                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <div class="compliance-item">
                                    <i class="bi bi-check-circle-fill text-<%= compliance.compliant ? 'success' : 'muted' %>"></i>
                                    <span><%= compliance.compliant %> of <%= compliance.applicable %> met</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="compliance-item">
                                    <i class="bi bi-exclamation-circle-fill text-<%= compliance.findings ? 'danger' : 'muted' %>"></i>
                                    <span><%= compliance.findings %> open finding<%= compliance.findings === 1 ? '' : 's' %></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="compliance-item">
                                    <i class="bi bi-hourglass-split text-<%= compliance.pending ? 'warning' : 'muted' %>"></i>
                                    <span><%= compliance.pending %> not yet checked</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-top text-end">
                            <a href="/compliance/farm/<%= farm.id %>" class="btn btn-sm btn-success">
                                <i class="bi bi-shield-check me-1"></i><%= compliance.assessed ? 'Continue to Compliance' : 'Start Compliance Check' %><i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Crops & Products -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-basket me-2 text-warning"></i>Main Crops / Products
                        </h5>
                        <div class="d-flex flex-wrap gap-2">
                            <% farm.mainCrops.split(',').forEach(crop => { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                <i class="bi bi-leaf me-1"></i><%= crop.trim() %>
                            </span>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <!-- GIS Map -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-map me-2 text-danger"></i>Geo-location / GIS Map
                        </h5>
                        <% if (farm.latitude && farm.longitude) { %>
                            <div id="farmMap" style="height: 400px; border-radius: 8px; overflow: hidden; margin-bottom: 1rem;"></div>
                            <div class="geo-info-panel">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="geo-info-item">
                                            <i class="bi bi-geo-alt-fill text-danger"></i>
                                            <div>
                                                <strong>Coordinates</strong>
                                                <p class="mb-0"><%= farm.latitude %>°N, <%= farm.longitude %>°E</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="geo-info-item">
                                            <i class="bi bi-house-door-fill text-info"></i>
                                            <div>
                                                <strong>Address</strong>
                                                <p class="mb-0"><%= farm.address %></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% if (applicant) { %>
                                    <div class="row g-3 mt-2">
                                        <% if (applicant.geoTagStatus === 'completed') { %>
                                            <div class="col-12">
                                                <div class="alert alert-success py-2 d-flex align-items-center gap-2 mb-0">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <div>
                                                        <strong>Geo-tagged:</strong> <%= applicant.geoTaggedDate %>
                                                        <% if (applicant.geoTaggedBy) { %>
                                                            <br><small>by <%= applicant.geoTaggedBy %></small>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        <% } else if (applicant.geoTagStatus === 'pending') { %>
                                            <div class="col-12">
                                                <div class="alert alert-warning py-2 d-flex align-items-center gap-2 mb-0">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    <strong>Pending Geo-tagging</strong>
                                                </div>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>No coordinates available yet.</strong> Geo-location information will be displayed once coordinates are set.
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>

<!-- Leaflet JS -->
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>

<script nonce="<%= cspNonce %>">
    // Initialize map if coordinates exist
    <% if (farm.latitude && farm.longitude) { %>
    document.addEventListener('DOMContentLoaded', function() {
        const farmMap = L.map('farmMap').setView([<%= farm.latitude %>, <%= farm.longitude %>], 13);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
            maxZoom: 19
        }).addTo(farmMap);
        
        // Add marker for the farm
        const marker = L.marker([<%= farm.latitude %>, <%= farm.longitude %>], {
            icon: L.icon({
                iconUrl: 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/images/marker-icon.png',
                iconRetinaUrl: 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/images/marker-icon-2x.png',
                shadowUrl: 'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            })
        }).addTo(farmMap);
        
        // Add popup
        marker.bindPopup(`
            <div>
                <strong><%= farm.name %></strong><br>
                <%= farm.address %><br>
                <small><%= farm.latitude %>°N, <%= farm.longitude %>°E</small>
            </div>
        `).openPopup();
    });
    <% } %>
</script>

<%- include('../partials/chatbot') %>
</body>
</html>
