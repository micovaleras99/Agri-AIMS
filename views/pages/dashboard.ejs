<%- include('../partials/header') %>
<%- include('../partials/navbar', { page, currentUser, role }) %>

<div class="main-wrapper">
<div class="page-content">

<!-- ══════════════════════════════════════════════════════════════
     ADMIN DASHBOARD
     ══════════════════════════════════════════════════════════════ -->
<% if (role === 'admin' || role === 'evaluator') { %>

<div class="page-header">
    <div>
        <h1 class="page-title">System Dashboard</h1>
        <p class="page-subtitle">
            Welcome back, <strong><%= currentUser.firstName %></strong> ·
            <%= currentUser.position %> ·
            <span class="text-muted"><%= new Date().toLocaleDateString('en-PH',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %></span>
        </p>
    </div>
    <a href="/admin/farmers/new" class="btn btn-primary"><i class="bi bi-person-plus me-2"></i>Register Farmer</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card"><div class="stat-icon bg-primary"><i class="bi bi-file-earmark-text"></i></div>
        <div class="stat-info"><h3><%= stats.totalApplications %></h3><p>Total Applications</p><small class="text-primary"><%= stats.pendingActions %> need action</small></div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card"><div class="stat-icon bg-success"><i class="bi bi-patch-check"></i></div>
        <div class="stat-info"><h3><%= stats.activeFarms %></h3><p>Active LSA Farms</p><small class="text-success"><%= stats.approved %> fully accredited</small></div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card"><div class="stat-icon bg-warning"><i class="bi bi-folder-check"></i></div>
        <div class="stat-info"><h3><%= stats.pendingDocReview %></h3><p>Docs Pending Review</p><small class="text-warning"><%= stats.totalDocuments %> total uploaded</small></div></div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card"><div class="stat-icon bg-info"><i class="bi bi-file-bar-graph"></i></div>
        <div class="stat-info"><h3><%= stats.pendingReports %></h3><p>Reports for Review</p><small class="text-info">Semestral submissions</small></div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="card-header-row mb-4">
                    <h5 class="card-title mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Applications</h5>
                    <a href="/applicants" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>ID</th><th>Applicant</th><th>Farm</th><th>Status</th><th>Progress</th><th class="text-end">Action</th></tr></thead>
                        <tbody>
                        <% recentApplications.forEach(a => {
                             // Jump straight to where the application actually is: its current
                             // step for one still in progress, or the overview once approved.
                             const goHref = a.status === 'approved'
                                 ? `/accreditation/${a.id}`
                                 : `/accreditation/${a.id}/step/${a.accreditationStep}`;
                        %>
                        <tr>
                            <td><a href="/applicants/<%= a.id %>" class="app-id-link"><%= a.applicationId %></a></td>
                            <td><%= a.firstName %> <%= a.lastName %></td>
                            <td class="text-muted small"><%= a.farmName %></td>
                            <td><span class="status-badge <%= a.status %>"><%= a.status.replace(/_/g,' ') %></span></td>
                            <td style="min-width:80px">
                                <div class="progress mb-1" style="height:5px"><div class="progress-bar" style="width:<%= a.progress %>%"></div></div>
                                <small class="text-muted"><%= a.progress %>%</small>
                            </td>
                            <td class="text-end">
                                <a href="<%= goHref %>" class="btn btn-xs btn-outline-primary text-nowrap">
                                    <% if (a.status === 'approved') { %>
                                    <i class="bi bi-eye me-1"></i>View
                                    <% } else { %>
                                    <i class="bi bi-arrow-right-circle me-1"></i>Step <%= a.accreditationStep %>
                                    <% } %>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-pie-chart me-2 text-primary"></i>Applications by Status</h5>
                <div style="height:200px;position:relative;"><canvas id="statusChart"></canvas></div>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="bi bi-lightning-charge me-2 text-warning"></i>Quick Actions</h5>
                <div class="quick-actions-grid">
                    <a href="/admin/farmers/new" class="quick-action-btn"><i class="bi bi-person-plus"></i><span>Register Farmer</span></a>
                    <a href="/documents"      class="quick-action-btn"><i class="bi bi-folder-check"></i><span>Review Docs</span></a>
                    <a href="/reports"        class="quick-action-btn"><i class="bi bi-bar-chart-line"></i><span>View Reports</span></a>
                    <a href="/directory"      class="quick-action-btn"><i class="bi bi-building"></i><span>LSA Directory</span></a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="card-header-row mb-3">
                    <h5 class="card-title mb-0"><i class="bi bi-hourglass-split me-2 text-warning"></i>Documents Awaiting Review</h5>
                    <a href="/documents?status=pending_review" class="btn btn-sm btn-outline-warning">View All</a>
                </div>
                <div class="row g-3">
                <% pendingDocuments.forEach(d => { %>
                <div class="col-md-3">
                    <div class="pending-doc-card">
                        <i class="bi bi-file-earmark-pdf text-danger fs-4"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small"><%= d.name %></div>
                            <div class="text-muted" style="font-size:12px"><%= d.applicantName %></div>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle mt-1" style="font-size:11px">Pending Review</span>
                        </div>
                    </div>
                </div>
                <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Step 5 validation worklist — merged from the former evaluator dashboard -->
<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="bi bi-calendar-week me-2 text-info"></i>
                    Field/Virtual Validation Schedule
                    <span class="badge bg-info-subtle text-info border ms-2" style="font-size:11px">Step 5 of 7</span>
                </h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr><th>App ID</th><th>Farm</th><th>Location</th><th>Date</th><th>Type</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                        <% if (!validationSchedule.length) { %>
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4" style="font-size:13px">
                                No application has reached field validation yet.
                                Applications appear here once their documents are reviewed at Step 4.
                            </td>
                        </tr>
                        <% } %>
                        <% validationSchedule.forEach(v => { %>
                        <tr>
                            <td class="app-id-link" style="font-size:12px"><%= v.applicationId %></td>
                            <td style="font-size:12px" class="fw-semibold"><%= v.farmName %></td>
                            <td class="text-muted" style="font-size:11px"><%= v.location %></td>
                            <td style="font-size:12px"><%= v.date || '—' %></td>
                            <td>
                                <% if (v.type) { %>
                                <span class="badge <%= v.type==='Field' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-info-subtle text-info border border-info-subtle' %>" style="font-size:11px">
                                    <i class="bi bi-<%= v.type==='Field' ? 'geo-alt' : 'camera-video' %> me-1"></i><%= v.type %>
                                </span>
                                <% } else { %>
                                <span class="text-muted" style="font-size:11px">—</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (v.state === 'validated') { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:11px">
                                    <i class="bi bi-check-circle me-1"></i>Validated<%= v.result ? ' · ' + v.result : '' %>
                                </span>
                                <% } else { %>
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:11px">
                                    <i class="bi bi-hourglass-split me-1"></i>Awaiting visit
                                </span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script nonce="<%= cspNonce %>">
document.addEventListener('DOMContentLoaded', function () {
new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: { labels:['Submitted','Doc Review','Under Review','Approved','Rejected'],
            datasets:[{data:[<%= statusCounts.submitted %>,<%= statusCounts.document_review %>,<%= statusCounts.under_review %>,<%= statusCounts.approved %>,<%= statusCounts.rejected %>],
            backgroundColor:['#3498db','#f39c12','#9b59b6','#27ae60','#e74c3c'],borderWidth:0}]},
    options:{ responsive:true,maintainAspectRatio:false,cutout:'66%',plugins:{legend:{position: window.innerWidth < 576 ? 'bottom' : 'right',labels:{font:{size:11},boxWidth:12}}}}
});
});
</script>

<!-- ══════════════════════════════════════════════════════════════
     LSA OPERATOR DASHBOARD
     Functions:
       1. Compliance Score Breakdown  — 6 Briefer responsibilities
       2. Monthly Visitor Bar Chart   — visitors + training sessions
       3. Semestral Report Calendar   — 5-year report schedule
       4. Operator Responsibility Checklist
     ══════════════════════════════════════════════════════════════ -->
<% } else if (role === 'operator') { %>

<%
// Renewal tone reused by the hero, the banner and the stat card.
const renewalTone = stats.daysToRenewal > 180 ? 'success' : stats.daysToRenewal > 60 ? 'warning' : 'danger';
// What needs the operator's attention, surfaced above the detail. Built from
// data already on the page, so it never disagrees with the sections below.
const overdueReport = reportCalendar.find((r) => r.status === 'overdue');
const upcomingReport = reportCalendar.find((r) => r.status === 'upcoming');
const attention = [];
if (overdueReport) {
    attention.push({ tone: 'danger', icon: 'exclamation-octagon-fill',
        text: 'Semestral report for <strong>' + overdueReport.period + '</strong> is overdue (was due ' + overdueReport.dueDate + ').',
        href: '/reports', cta: 'Submit now' });
} else if (upcomingReport) {
    attention.push({ tone: 'warning', icon: 'alarm-fill',
        text: 'Next semestral report (<strong>' + upcomingReport.period + '</strong>) is due ' + upcomingReport.dueDate + '.',
        href: '/reports', cta: 'Submit' });
}
if (stats.daysToRenewal <= 180) {
    attention.push({ tone: stats.daysToRenewal <= 60 ? 'danger' : 'warning', icon: 'calendar-check-fill',
        text: stats.daysToRenewal < 0
            ? 'Accreditation <strong>expired</strong> ' + Math.abs(stats.daysToRenewal) + ' days ago (' + myFarm.expiryDate + ').'
            : 'Accreditation expires in <strong>' + stats.daysToRenewal + ' days</strong> (' + myFarm.expiryDate + ').',
        href: '/renewal', cta: 'View renewal' });
}
%>

<!-- ── Operator hero: farm identity + primary action ──────────── -->
<div class="card mb-4 applicant-hero">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h1 class="page-title mb-0"><%= myFarm.name %></h1>
                    <span class="badge bg-success align-middle"><%= myFarm.accreditationLevel %></span>
                </div>
                <p class="text-muted mb-0 small">
                    <i class="bi bi-geo-alt me-1"></i><%= myFarm.municipality %>, <%= myFarm.province %>
                    <span class="mx-1">·</span>
                    <i class="bi bi-tag me-1"></i><%= classificationLabel(myFarm.classification) %>
                    <span class="mx-1">·</span>
                    <i class="bi bi-calendar-check me-1"></i>Renews <%= myFarm.expiryDate %>
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a href="/reports" class="btn btn-success fw-bold">
                    <i class="bi bi-file-earmark-plus me-2"></i>Submit Semestral Report
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ── Needs your attention (only when something is actionable) ─ -->
<% if (attention.length) { %>
<div class="attention-panel mb-4">
    <div class="attention-panel__head">
        <i class="bi bi-bell-fill"></i><span>Needs your attention</span>
    </div>
    <% attention.forEach((a) => { %>
    <div class="attention-item attention-item--<%= a.tone %>">
        <i class="bi bi-<%= a.icon %> attention-item__icon"></i>
        <span class="attention-item__text"><%- a.text %></span>
        <a href="<%= a.href %>" class="btn btn-sm btn-<%= a.tone %>"><%= a.cta %></a>
    </div>
    <% }) %>
</div>
<% } %>

<!-- ── Operator Stat Cards (each links to its detail page) ────── -->
<div class="row g-4 mb-4">
    <div class="col-6 col-xl-3">
        <a href="/reports" class="stat-card border-start border-info border-4 text-decoration-none">
            <div class="stat-icon bg-info"><i class="bi bi-people"></i></div>
            <div class="stat-info">
                <h3><%= stats.visitorsThisYear %></h3><p>Visitors This Year</p>
                <small class="text-info">Farm visits &amp; training participants</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a href="/reports" class="stat-card border-start border-primary border-4 text-decoration-none">
            <div class="stat-icon bg-primary"><i class="bi bi-mortarboard"></i></div>
            <div class="stat-info">
                <h3><%= stats.trainingSessions %></h3><p>Training Sessions</p>
                <small class="text-primary">Lectures &amp; orientations</small>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <% const scoreTone = !complianceAssessed ? 'secondary'
             : stats.complianceScore >= 80 ? 'success'
             : stats.complianceScore >= 60 ? 'warning' : 'danger'; %>
        <a href="/compliance" class="stat-card border-start border-<%= scoreTone %> border-4 text-decoration-none">
            <div class="stat-icon bg-<%= scoreTone %>">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="stat-info">
                <% if (!complianceAssessed) { %>
                <h3>&mdash;</h3><p>Compliance Score</p>
                <small class="text-muted"><%= stats.totalItems %> responsibilities not yet checked</small>
                <% } else { %>
                <h3><%= stats.complianceScore %>%</h3><p>Compliance Score</p>
                <small class="text-<%= stats.complianceScore >= 80 ? 'success' : 'warning' %>">
                    <%= stats.compliantItems %>/<%= stats.totalItems %> responsibilities met
                </small>
                <% } %>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a href="/renewal" class="stat-card border-start border-<%= renewalTone %> border-4 text-decoration-none">
            <div class="stat-icon bg-<%= renewalTone %>">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="stat-info">
                <h3><%= stats.daysToRenewal %></h3><p>Days to Renewal</p>
                <small class="text-muted">Expires <%= myFarm.expiryDate %></small>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- ── FUNCTION 2: Monthly Visitor Activity Chart ────────── -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <div class="card-header-row mb-4">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-bar-chart-line me-2 text-primary"></i>
                        Visitors &amp; Training per Reporting Period
                    </h5>
                    <% if (activity.periods) { %>
                    <span class="badge bg-success-subtle text-success border">
                        <i class="bi bi-people me-1"></i><%= activity.totalVisitors %> visitors reported
                    </span>
                    <% } %>
                </div>
                <% if (!activity.periods) { %>
                <div class="text-center text-muted py-5">
                    <i class="bi bi-bar-chart-line d-block mb-2" style="font-size:2rem;opacity:.35;"></i>
                    <p class="mb-1">No semestral report has been submitted yet.</p>
                    <small>
                        Visitor and training figures come from the semestral accomplishment
                        report<% if (activity.nextDue) { %>, next due <strong><%= activity.nextDue %></strong><% } %>.
                    </small>
                </div>
                <% } else { %>
                <canvas id="visitorChart" style="max-height:240px;"></canvas>
                <div class="d-flex gap-4 mt-3 justify-content-center">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:14px;height:14px;border-radius:3px;background:rgba(39,174,96,0.75);"></div>
                        <small class="text-muted">Visitors</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:14px;height:14px;border-radius:3px;background:rgba(52,152,219,0.75);"></div>
                        <small class="text-muted">Training Sessions</small>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ── FUNCTION 1: Compliance Score + Responsibilities ────── -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title mb-1">
                    <i class="bi bi-shield-check me-2 text-success"></i>
                    Compliance Score Breakdown
                </h5>
                <p class="text-muted small mb-3">
                    Based on ATI Briefer responsibilities for LSA I operators
                </p>

                <!-- Overall compliance gauge.
                     A farm nobody has checked scores 0%, which is the same
                     number a farm checked and found failing scores. Say which
                     one this is rather than painting an unvisited site red. -->
                <div class="compliance-gauge mb-4">
                    <% if (!complianceAssessed) { %>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Overall Compliance</span>
                        <span class="fw-bold text-secondary">Not yet assessed</span>
                    </div>
                    <div class="progress mb-1" style="height:14px;border-radius:7px;">
                        <div class="progress-bar bg-secondary-subtle" style="width:100%"></div>
                    </div>
                    <small class="text-muted">
                        All <%= stats.totalItems %> ATI Briefer responsibilities are awaiting their
                        first monitoring visit. None has been recorded as met or unmet.
                    </small>
                    <% } else { %>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Overall Compliance</span>
                        <span class="fw-bold fs-5 text-<%= stats.complianceScore >= 80 ? 'success' : stats.complianceScore >= 60 ? 'warning' : 'danger' %>">
                            <%= stats.complianceScore %>%
                        </span>
                    </div>
                    <div class="progress mb-1" style="height:14px;border-radius:7px;">
                        <div class="progress-bar bg-<%= stats.complianceScore >= 80 ? 'success' : stats.complianceScore >= 60 ? 'warning' : 'danger' %>"
                             style="width:<%= stats.complianceScore %>%">
                            <%= stats.complianceScore %>%
                        </div>
                    </div>
                    <small class="text-muted">
                        <%= stats.compliantItems %> of <%= stats.totalItems %> ATI Briefer responsibilities met<% if (compliancePending) { %>,
                        <%= compliancePending %> not yet checked<% } %>
                    </small>
                    <% } %>
                </div>

                <!-- Responsibility items -->
                <%
                   // One colour and one icon per real state. "Not yet checked"
                   // is not a failure, and "not applicable" is not compliance.
                   const COMPLIANCE_TONE = {
                     compliant:      { tone: 'success',   icon: 'check-circle' },
                     partial:        { tone: 'warning',   icon: 'dash-circle' },
                     non_compliant:  { tone: 'danger',    icon: 'x-circle' },
                     not_applicable: { tone: 'secondary', icon: 'slash-circle' },
                     pending:        { tone: 'secondary', icon: 'clock' },
                   };
                %>
                <% complianceItems.forEach(item => { %>
                <% const tone = (COMPLIANCE_TONE[item.status] || COMPLIANCE_TONE.pending); %>
                <div class="compliance-resp-item">
                    <div class="compliance-resp-icon bg-<%= tone.tone %>-subtle text-<%= tone.tone %>">
                        <i class="bi bi-<%= item.icon %>"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-semibold" style="font-size:12px;line-height:1.3">
                            <%= item.label %>
                        </div>
                        <div class="text-muted" style="font-size:10px;line-height:1.3">
                            <%= item.desc %>
                        </div>
                    </div>
                    <span class="badge flex-shrink-0 bg-<%= tone.tone %>-subtle text-<%= tone.tone %> border"
                          style="font-size:10px;">
                        <i class="bi bi-<%= tone.icon %> me-1"></i><%= item.statusLabel %>
                    </span>
                </div>
                <% }) %>
            </div>
        </div>
    </div>

</div>

<!-- ── FUNCTION 3: Semestral Report Calendar (5-year) ────────── -->
<div class="row g-4 mt-0">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="card-header-row mb-4">
                    <div>
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calendar3-range me-2 text-success"></i>
                            Semestral Report Calendar
                            <span class="badge bg-success-subtle text-success border ms-2" style="font-size:11px">
                                5-Year Accreditation Period
                            </span>
                        </h5>
                        <p class="text-muted small mb-0 mt-1">
                            ATI Briefer requirement: <em>"Submit a semestral accomplishment report to the ATI which
                            contains operation records: production and sales data, technologies developed/shared,
                            farm activities, visitors and trainees served."</em>
                        </p>
                    </div>
                    <a href="/reports" class="btn btn-sm btn-outline-success">View Reports</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th>Due Date</th>
                                <th>Submitted</th>
                                <th>Visitors</th>
                                <th>Trainings</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% reportCalendar.forEach(r => { %>
                        <tr class="<%= r.status === 'upcoming' ? 'table-warning' : r.status === 'overdue' ? 'table-danger' : '' %>">
                            <td>
                                <span class="fw-bold"><%= r.period %></span>
                                <% if (r.status === 'upcoming') { %>
                                <span class="badge bg-warning text-dark ms-2" style="font-size:10px;">
                                    <i class="bi bi-alarm me-1"></i>Next Due
                                </span>
                                <% } %>
                            </td>
                            <td class="text-muted small"><%= r.dueDate %></td>
                            <td class="small">
                                <% if (r.submitted) { %>
                                <span class="text-success"><i class="bi bi-check-circle me-1"></i><%= r.submitted %></span>
                                <% } else if (r.status === 'upcoming') { %>
                                <span class="text-warning">Pending</span>
                                <% } else if (r.status === 'overdue') { %>
                                <span class="text-danger fw-bold">OVERDUE</span>
                                <% } else { %>
                                <span class="text-muted">—</span>
                                <% } %>
                            </td>
                            <td class="text-center">
                                <% if (r.visitors !== null) { %>
                                <span class="badge bg-info-subtle text-info border"><%= r.visitors %></span>
                                <% } else { %><span class="text-muted small">—</span><% } %>
                            </td>
                            <td class="text-center">
                                <% if (r.sessions !== null) { %>
                                <span class="badge bg-success-subtle text-success border"><%= r.sessions %></span>
                                <% } else { %><span class="text-muted small">—</span><% } %>
                            </td>
                            <td>
                                <span class="status-badge <%= r.status %>"><%= r.status %></span>
                            </td>
                            <td class="text-center">
                                <% if (r.status === 'upcoming' || r.status === 'overdue') { %>
                                <a href="/reports" class="btn btn-xs btn-success fw-bold">Submit</a>
                                <% } else if (r.status === 'pending' || r.status === 'approved') { %>
                                <a href="/reports" class="btn btn-xs btn-outline-secondary">View</a>
                                <% } else { %>
                                <span class="text-muted small">—</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- ── FUNCTION 4: Responsibility Reminders ─────── -->
                <div class="row g-3 mt-3">
                <% responsibilityStatus.forEach(r => { %>
                <div class="col-md-3">
                    <div class="responsibility-reminder-card <%= r.urgent ? 'urgent' : '' %>">
                        <div class="reminder-icon">
                            <i class="bi bi-<%= r.urgent ? 'exclamation-triangle-fill text-danger' : 'check-circle text-success' %>"></i>
                        </div>
                        <div>
                            <div class="fw-semibold" style="font-size:12px;"><%= r.task %></div>
                            <div class="text-muted" style="font-size:11px;">Due: <%= r.due %></div>
                        </div>
                    </div>
                </div>
                <% }) %>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ── Your LSA Certificate & Documents ──────────────────────── -->
<% if (typeof atiDocs !== 'undefined' && atiDocs.length) { %>
<div class="card mt-4">
    <div class="card-body">
        <div class="card-header-row mb-1">
            <h5 class="card-title mb-0"><i class="bi bi-patch-check me-2 text-success"></i>Your LSA Certificate &amp; Documents</h5>
            <a href="/documents" class="btn btn-sm btn-outline-success"><i class="bi bi-folder2-open me-1"></i>All Documents</a>
        </div>
        <p class="text-muted small mb-3">
            Documents ATI issued for your Learning Site. Click to view or download.
        </p>
        <div class="doc-checklist-list">
        <% atiDocs.forEach(d => { %>
        <div class="doc-checklist-item">
            <i class="bi bi-<%= d.icon %> text-success flex-shrink-0"></i>
            <div class="flex-grow-1 min-w-0">
                <div class="small fw-semibold"><%= d.label %></div>
                <div class="text-muted" style="font-size:10px">Issued at Step <%= d.step %> · <%= d.uploadDate %></div>
            </div>
            <a href="/documents/<%= d.id %>/file" target="_blank" rel="noopener"
               class="btn btn-xs btn-outline-success flex-shrink-0">
                <i class="bi bi-download me-1"></i>View
            </a>
        </div>
        <% }) %>
        </div>
    </div>
</div>
<% } %>

<script nonce="<%= cspNonce %>">
document.addEventListener('DOMContentLoaded', function () {
// ── Visitor + Training dual-axis bar chart ──────────────────────
// Drawn only when there is something to draw: the canvas is not rendered until
// at least one semestral report has been submitted.
if (document.getElementById('visitorChart')) {
new Chart(document.getElementById('visitorChart'), {
    type: 'bar',
    data: {
        labels:   <%- safeJson(activity.labels) %>,
        datasets: [
            {
                label:           'Visitors',
                data:            <%- safeJson(activity.visitors) %>,
                backgroundColor: 'rgba(39,174,96,0.75)',
                borderRadius:    5,
                yAxisID:         'y'
            },
            {
                label:           'Training Sessions',
                data:            <%- safeJson(activity.trainings) %>,
                backgroundColor: 'rgba(52,152,219,0.75)',
                borderRadius:    5,
                yAxisID:         'y1'
            }
        ]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins:  { legend: { display: false } },
        scales: {
            y:  {
                type: 'linear', position: 'left',
                beginAtZero: true,
                title: { display: true, text: 'Visitors', color: '#27ae60', font: { size: 11 } },
                grid: { color: '#f0f0f0' }
            },
            y1: {
                type: 'linear', position: 'right',
                beginAtZero: true,
                ticks: { precision: 0 },
                title: { display: true, text: 'Sessions', color: '#3498db', font: { size: 11 } },
                grid: { drawOnChartArea: false }
            }
        }
    }
});
}
});
</script>


<!-- ══════════════════════════════════════════════════════════════
     APPLICANT DASHBOARD
     ══════════════════════════════════════════════════════════════ -->
<% } else { %>

<div class="page-header">
    <div>
        <h1 class="page-title">My Application</h1>
        <p class="page-subtitle">
            ID: <span class="app-id-link"><%= myApp.applicationId %></span> ·
            <span class="status-badge <%= myApp.status %>"><%= myApp.status.replace(/_/g,' ') %></span>
        </p>
    </div>
    
</div>

<div class="card mb-4 applicant-hero">
    <div class="card-body p-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h5 class="fw-bold mb-1"><%= myApp.farmName %></h5>
                <p class="text-muted mb-3 small">
                    <i class="bi bi-geo-alt me-1"></i><%= myApp.municipality %>, <%= myApp.province %> ·
                    <i class="bi bi-tag me-1 ms-2"></i><%= classificationLabel(myApp.classification) %>
                </p>
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-semibold">Overall Progress</span>
                    <span class="fw-bold text-primary fs-5"><%= myApp.progress %>%</span>
                </div>
                <div class="progress mb-2" style="height:14px;border-radius:7px;">
                    <div class="progress-bar" style="width:<%= myApp.progress %>%"></div>
                </div>
                <small class="text-muted">Step <%= myApp.accreditationStep %> of 7 · Submitted <%= myApp.submissionDate %></small>
            </div>
            <div class="col-lg-6">
                <div class="row g-3 text-center">
                    <div class="col-4"><div class="applicant-mini-stat"><h4><%= docStats.verified %></h4><small>Verified</small></div></div>
                    <div class="col-4"><div class="applicant-mini-stat warning"><h4><%= docStats.pending %></h4><small>Pending</small></div></div>
                    <div class="col-4"><div class="applicant-mini-stat danger"><h4><%= docStats.missing %></h4><small>Missing</small></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <%
                    const cur = myApp.accreditationStep;
                    const approved = myApp.status === 'approved';
                    const returned = myApp.status === 'document_review' && cur >= 4;
                    // Where the applicant should go next: an actionable step they own,
                    // otherwise the read-only overview.
                    const nextActionable = returned ? 3 : cur;
                    const continueHref = [1, 2, 3].includes(nextActionable)
                        ? `/accreditation/${myApp.id}/step/${nextActionable}`
                        : `/accreditation/${myApp.id}`;
                %>
                <div class="card-header-row mb-4">
                    <h5 class="card-title mb-0"><i class="bi bi-diagram-3 me-2 text-primary"></i>7-Step LSA Accreditation Process</h5>
                    <a href="<%= continueHref %>" class="btn btn-sm btn-primary">
                        <% if (approved) { %><i class="bi bi-award me-1"></i>View Accreditation<% } else { %><i class="bi bi-arrow-right-circle me-1"></i>Continue<% } %>
                    </a>
                </div>
                <% if (returned) { %>
                <div class="alert alert-warning py-2 px-3 small mb-3">
                    <i class="bi bi-arrow-return-left me-1"></i>
                    ATI returned your documents for revision. Re-submit the flagged requirements to continue.
                </div>
                <% } %>
                <div class="lsa-steps-list">
                <% lsaSteps.forEach(s => {
                    const st = (approved || s.step < cur) ? 'completed'
                             : s.step === cur ? 'active' : 'pending';
                    // Steps 1-3 are the applicant's to act on; 4-7 are ATI's, so the
                    // applicant only watches their status there.
                    const mine = [1, 2, 3].includes(s.step);
                    const href = mine ? `/accreditation/${myApp.id}/step/${s.step}` : null;
                    let label = 'Upcoming', cls = 'secondary';
                    if (st === 'completed') { label = 'Completed'; cls = 'success'; }
                    else if (st === 'active') {
                        if (returned && s.step === 4) { label = 'Returned to you'; cls = 'danger'; }
                        else if (mine) { label = 'Your turn'; cls = 'primary'; }
                        else if (s.step === 7) { label = 'Awaiting certificate'; cls = 'warning'; }
                        else { label = 'With ATI'; cls = 'warning'; }
                    }
                %>
                <div class="lsa-step-item <%= st %>">
                    <div class="lsa-step-circle">
                        <% if (st==='completed') { %><i class="bi bi-check-lg"></i><% } else { %><%= s.step %><% } %>
                    </div>
                    <div class="lsa-step-content">
                        <div class="lsa-step-title">
                            <% if (href) { %><a href="<%= href %>" class="text-decoration-none"><%= s.label %></a><% } else { %><%= s.label %><% } %>
                        </div>
                        <div class="lsa-step-desc"><%= s.desc %></div>
                    </div>
                    <span class="badge bg-<%= cls %>-subtle text-<%= cls %> border align-self-center"><%= label %></span>
                </div>
                <% }) %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="card-header-row mb-3">
                    <h5 class="card-title mb-0"><i class="bi bi-folder-check me-2 text-primary"></i>Documentary Requirements</h5>
                    <a href="/documents/submit" class="btn btn-sm btn-primary"><i class="bi bi-upload me-1"></i>Upload</a>
                </div>
                <div class="doc-progress-summary mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="fw-semibold">Submitted</small>
                        <small class="fw-bold"><%= docStats.verified + docStats.pending %>/<%= docStats.total %></small>
                    </div>
                    <div class="progress" style="height:8px;border-radius:4px;">
                        <div class="progress-bar bg-success" style="width:<%= Math.round((docStats.verified/docStats.total)*100) %>%"></div>
                        <div class="progress-bar bg-warning" style="width:<%= Math.round((docStats.pending/docStats.total)*100) %>%"></div>
                    </div>
                </div>
                <div class="doc-checklist-list">
                <% docChecklist.forEach(d => { %>
                <div class="doc-checklist-item">
                    <% if (d.status==='verified') { %>
                    <i class="bi bi-check-circle-fill text-success flex-shrink-0"></i>
                    <% } else if (d.status==='pending_review') { %>
                    <i class="bi bi-clock-fill text-warning flex-shrink-0"></i>
                    <% } else { %>
                    <i class="bi bi-circle text-secondary flex-shrink-0"></i>
                    <% } %>
                    <div class="flex-grow-1 min-w-0">
                        <div class="small <%= d.status==='missing' ? 'text-muted' : 'fw-semibold' %>"><%= d.name %></div>
                        <div class="text-muted" style="font-size:10px"><%= d.form %></div>
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                        <% if (d.hasForm) { %>
                        <a href="/forms/<%= d.type %>" class="btn btn-xs btn-outline-secondary" title="Download the prescribed form">Download</a>
                        <% } %>
                        <% if (d.status==='missing') { %>
                        <a href="/documents/submit?type=<%= d.type %>" class="btn btn-xs btn-outline-primary">Upload</a>
                        <% } %>
                    </div>
                </div>
                <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Documents from ATI (validation report, endorsement, certificate) ── -->
<% if (typeof atiDocs !== 'undefined' && atiDocs.length) { %>
<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title mb-1"><i class="bi bi-file-earmark-check me-2 text-success"></i>Documents from ATI</h5>
        <p class="text-muted small mb-3">
            Completed documents ATI has issued for your application. Click to view or download.
        </p>
        <div class="doc-checklist-list">
        <% atiDocs.forEach(d => { %>
        <div class="doc-checklist-item">
            <i class="bi bi-<%= d.icon %> text-success flex-shrink-0"></i>
            <div class="flex-grow-1 min-w-0">
                <div class="small fw-semibold"><%= d.label %></div>
                <div class="text-muted" style="font-size:10px">Issued at Step <%= d.step %> · <%= d.uploadDate %></div>
            </div>
            <a href="/documents/<%= d.id %>/file" target="_blank" rel="noopener"
               class="btn btn-xs btn-outline-success flex-shrink-0">
                <i class="bi bi-download me-1"></i>View
            </a>
        </div>
        <% }) %>
        </div>
    </div>
</div>
<% } %>

<% } %>

</div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<%- include('../partials/chatbot') %>
</body>
</html>
