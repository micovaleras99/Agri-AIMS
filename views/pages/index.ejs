<%- include('../partials/header') %>


<div class="auth-container farm-background">
    <!-- Video Background -->
<video
  autoplay
  muted
  loop
  playsinline
  preload="none"
  poster="/images/auth-backdrop.jpeg"
  disablePictureInPicture
  controlsList="nodownload nofullscreen noremoteplayback"
  class="video-background"
  id="authBackgroundVideo"
  data-src="/videos/ati-web.mp4"></video>


    <div class="auth-box">

        <!-- Brand Header -->
        <div class="auth-header">
            <!-- ATI Logo -->
            <div style="display: flex; justify-content: center; margin-bottom: 20px;">
                <img src="/images/logo.png" alt="ATI LSA Logo" class="auth-logo">
            </div>
            <h1>ATI LSA - AIMS</h1>
            <p style="font-weight: 600; color: rgba(45, 122, 62, 0.9); margin-bottom: 12px;">Agricultural Training Institute<br>Learning Site Accreditation</p>
            <div class="auth-badge">
                <i class="ph-fill ph-map-pin me-1"></i>ATI-RTC V · Bicol Region
            </div>
        </div>

        <!-- Auth Tabs -->
        <div class="auth-tabs">
            <button class="auth-tab active" data-call="switchAuthTab" data-args='["login","@this"]'>Login</button>
            <button class="auth-tab"        data-call="switchAuthTab" data-args='["register","@this"]'>Register</button>
        </div>

        <!-- ── Login Form ── -->
        <form id="loginForm" class="auth-form">
            <input type="hidden" name="role" id="loginRoleField" value="admin">
            
            <!-- Scrollable Content -->
            <div class="auth-form-content">
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="loginEmail"
                           placeholder="email" value="<%= demoLogin ? 'admin@ati-bicol.da.gov.ph' : '' %>" required>
                    <label for="loginEmail"><i class="ph ph-envelope me-1"></i>Email Address</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control has-pw-toggle" id="loginPassword"
                           placeholder="Password" value="<%= demoLogin ? 'admin123' : '' %>" required>
                    <label for="loginPassword"><i class="ph ph-lock me-1"></i>Password</label>
                    <button type="button" class="pw-toggle" data-target="loginPassword"
                            aria-label="Show password"><i class="ph ph-eye-slash"></i></button>
                </div>

                <div class="text-end mb-2">
                    <button type="button" class="btn btn-link btn-sm p-0" id="forgotLink">Forgot password?</button>
                </div>

                <!-- ── Role Selector (development demo only) ── -->
                <% if (demoLogin) { %>
                <div class="role-selector mb-4">
                    <p class="role-selector-label">
                        <i class="ph ph-identification-badge me-1"></i>Login as:
                    </p>
                    <div class="role-cards" id="roleCards" role="radiogroup" aria-label="Login as">

                        <div class="role-card active" data-role="admin"
                             role="radio" tabindex="0" aria-checked="true"
                             aria-label="Sign in as Administrator"
                             data-call="selectRole" data-args='["admin","admin@ati-bicol.da.gov.ph","admin123","@this"]'>
                            <div class="role-card-icon bg-danger">
                                <i class="ph-fill ph-shield"></i>
                            </div>
                            <div class="role-card-info">
                                <div class="role-card-name">Administrator</div>
                                <div class="role-card-desc">ATI Staff · Full Access</div>
                            </div>
                            <i class="ph-fill ph-check-circle role-check text-danger"></i>
                        </div>

                        <div class="role-card" data-role="operator"
                             role="radio" tabindex="0" aria-checked="false"
                             aria-label="Sign in as LSA Operator"
                             data-call="selectRole" data-args='["operator","operator@lsa.ph","operator123","@this"]'>
                            <div class="role-card-icon bg-success">
                                <i class="ph-fill ph-tree"></i>
                            </div>
                            <div class="role-card-info">
                                <div class="role-card-name">LSA Operator</div>
                                <div class="role-card-desc">Certified Farm Operator</div>
                            </div>
                            <i class="ph-fill ph-check-circle role-check text-success" style="display:none;"></i>
                        </div>

                        <div class="role-card" data-role="applicant"
                             role="radio" tabindex="0" aria-checked="false"
                             aria-label="Sign in as Applicant"
                             data-call="selectRole" data-args='["applicant","applicant@email.com","applicant123","@this"]'>
                            <div class="role-card-icon bg-primary">
                                <i class="ph-fill ph-user-plus"></i>
                            </div>
                            <div class="role-card-info">
                                <div class="role-card-name">Applicant</div>
                                <div class="role-card-desc">New LSA Application</div>
                            </div>
                            <i class="ph-fill ph-check-circle role-check text-primary" style="display:none;"></i>
                        </div>

                    </div>
                </div>
                <% } %>
            </div>

            <!-- Fixed Button at Bottom -->
            <button type="submit" class="btn btn-primary w-100 btn-lg auth-form-button" id="loginSubmitBtn">
                <i class="ph ph-sign-in me-2"></i>Login
            </button>
        </form>

        <!-- ── Register Form ── -->
        <form id="registerForm" class="auth-form" style="display:none;">
            
            <!-- Scrollable Content -->
            <div class="auth-form-content">
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="regFirst" placeholder="First Name" required>
                            <label for="regFirst">First Name</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="regLast" placeholder="Last Name" required>
                            <label for="regLast">Last Name</label>
                        </div>
                    </div>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="regEmail" placeholder="Email" required>
                    <label for="regEmail"><i class="ph ph-envelope me-1"></i>Email Address</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="tel" class="form-control" id="regPhone" placeholder="Phone" required>
                    <label for="regPhone"><i class="ph ph-phone me-1"></i>Contact Number</label>
                </div>
                <div class="form-floating mb-3">
                    <select class="form-select" id="regRole" required>
                        <option value="">Select how you will register</option>
                        <option value="applicant">Applicant — New LSA Application</option>
                        <option value="operator">LSA Operator — Certified Operator</option>
                    </select>
                    <label for="regRole"><i class="ph ph-identification-badge me-1"></i>Register As</label>
                </div>
                <div id="regApplicantExtra" class="d-none">
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="regFarmName" placeholder="Farm name">
                        <label for="regFarmName"><i class="ph ph-tree me-1"></i>Farm / enterprise name</label>
                    </div>
                    <!-- Asked for the "complete address", people typed the barangay and
                         city they were about to select again below. This field is for
                         what the location dropdowns cannot hold: the detail beneath
                         the barangay. -->
                    <div class="mb-3">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="regFarmAddress"
                                   placeholder="Purok 3, Zone II">
                            <label for="regFarmAddress">Street / purok / sitio</label>
                        </div>
                        <div class="form-text">Barangay, city and province are selected below.</div>
                    </div>
                    <!-- These four decide which documents the application will owe and
                         whether the farm meets the minimum area, and the record was
                         being created without ever asking for them. -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="form-floating">
                                <input type="number" min="0" step="1" class="form-control"
                                       id="regFarmArea" placeholder="Farm area">
                                <label for="regFarmArea">Farm area (sq.m.)</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <select class="form-select" id="regLsaType">
                                    <option value="regular">Regular LSA</option>
                                    <option value="rcef">RCEF-LSA</option>
                                    <option value="coco">Coco-LSA</option>
                                </select>
                                <label for="regLsaType">LSA type</label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="form-floating">
                                <select class="form-select" id="regCategory">
                                    <option value="private">Private-owned</option>
                                    <option value="organization">Farmers/Fishers Organization</option>
                                    <option value="government">Government-owned</option>
                                </select>
                                <label for="regCategory">Applicant category</label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <select class="form-select" id="regClassification">
                                    <option value="">Select classification</option>
                                    <optgroup label="Farming LSA">
                                        <% classificationOptions.farming.forEach(function (c) { %>
                                        <option value="<%= c.key %>"><%= c.label %></option>
                                        <% }) %>
                                    </optgroup>
                                    <optgroup label="Agri-Processing LSA">
                                        <% classificationOptions.processing.forEach(function (c) { %>
                                        <option value="<%= c.key %>"><%= c.label %></option>
                                        <% }) %>
                                    </optgroup>
                                </select>
                                <label for="regClassification">LSA classification</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="regRsbsa"
                               placeholder="RSBSA number">
                        <label for="regRsbsa">RSBSA / NCFRS number <span class="text-muted">(optional)</span></label>
                    </div>
                    <div class="row g-2 mb-3">
                        <%- include('../partials/location-select', {
                            prefix: 'reg',
                            required: false,
                            cols: 'col-md-6',
                            selected: null
                        }) %>
                    </div>
                </div>
                <div id="regOperatorExtra" class="d-none mb-3">
                    <div class="form-floating">
                        <select class="form-select" id="regFarmId">
                            <option value="">Link to your LSA farm (optional)</option>
                        </select>
                        <label for="regFarmId"><i class="ph ph-map-pin me-1"></i>Accredited farm</label>
                    </div>
                    <small class="text-muted">Choose the farm you operate so reports and maps match your account. You can leave this blank and an admin can link it later.</small>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control has-pw-toggle" id="regPass" placeholder="Password" required>
                    <label for="regPass"><i class="ph ph-lock me-1"></i>Password</label>
                    <button type="button" class="pw-toggle" data-target="regPass"
                            aria-label="Show password"><i class="ph ph-eye-slash"></i></button>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control has-pw-toggle" id="regConf" placeholder="Confirm" required>
                    <label for="regConf"><i class="ph-fill ph-lock me-1"></i>Confirm Password</label>
                    <button type="button" class="pw-toggle" data-target="regConf"
                            aria-label="Show password"><i class="ph ph-eye-slash"></i></button>
                </div>
                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" id="agree" required>
                    <label class="form-check-label small" for="agree">
                        I agree to the <a href="#" class="text-primary">Terms and Conditions</a>
                    </label>
                </div>
            </div>

            <!-- Fixed Button at Bottom -->
            <button type="submit" class="btn btn-primary w-100 btn-lg auth-form-button" id="registerSubmitBtn">
                <i class="ph ph-user-plus me-2"></i>Create Account
            </button>
        </form>

        <!-- ── OTP Verification (registration + password reset) ── -->
        <div id="otpForm" class="auth-form" style="display:none;">
            <div class="auth-form-content">
                <h2 id="otpTitle" class="h5 fw-bold mb-1">Verify Your Email</h2>
                <p id="otpSubtitle" class="text-muted small mb-3">We've sent a 6-digit verification code to your email address.</p>
                <div class="otp-inputs" id="otpInputs" role="group" aria-label="6-digit verification code">
                    <input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="1" class="otp-box" aria-label="Digit 1">
                    <input type="text" inputmode="numeric" maxlength="1" class="otp-box" aria-label="Digit 2">
                    <input type="text" inputmode="numeric" maxlength="1" class="otp-box" aria-label="Digit 3">
                    <input type="text" inputmode="numeric" maxlength="1" class="otp-box" aria-label="Digit 4">
                    <input type="text" inputmode="numeric" maxlength="1" class="otp-box" aria-label="Digit 5">
                    <input type="text" inputmode="numeric" maxlength="1" class="otp-box" aria-label="Digit 6">
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3 small">
                    <span class="text-muted">OTP expires in: <span id="otpCountdown" aria-live="polite">05:00</span></span>
                    <button type="button" class="btn btn-link btn-sm p-0" id="otpResendBtn" disabled>Resend OTP</button>
                </div>
                <div id="otpMessage" class="small mt-2" role="alert" aria-live="polite"></div>
            </div>
            <button type="button" class="btn btn-primary w-100 btn-lg auth-form-button" id="otpVerifyBtn">
                <i class="ph ph-check-circle me-2"></i>Verify OTP
            </button>
            <button type="button" class="btn btn-link w-100 mt-1" id="otpBackBtn">Back</button>
        </div>

        <!-- ── Forgot Password: enter email ── -->
        <form id="forgotForm" class="auth-form" style="display:none;">
            <div class="auth-form-content">
                <h2 class="h5 fw-bold mb-1">Reset Password</h2>
                <p class="text-muted small mb-3">Enter your registered email address and we'll send a 6-digit verification code.</p>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="forgotEmail" placeholder="email" required>
                    <label for="forgotEmail"><i class="ph ph-envelope me-1"></i>Email Address</label>
                </div>
                <div id="forgotMessage" class="small" role="alert" aria-live="polite"></div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg auth-form-button" id="forgotSubmitBtn">
                <i class="ph ph-paper-plane-right me-2"></i>Send Code
            </button>
            <button type="button" class="btn btn-link w-100 mt-1" id="forgotBackBtn">Back to login</button>
        </form>

        <!-- ── Reset Password: new password ── -->
        <form id="resetForm" class="auth-form" style="display:none;">
            <div class="auth-form-content">
                <h2 class="h5 fw-bold mb-1">Create New Password</h2>
                <p class="text-muted small mb-3">Choose a new password for your account.</p>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control has-pw-toggle" id="resetPass" placeholder="New password" required>
                    <label for="resetPass"><i class="ph ph-lock me-1"></i>New Password</label>
                    <button type="button" class="pw-toggle" data-target="resetPass" aria-label="Show password"><i class="ph ph-eye-slash"></i></button>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control has-pw-toggle" id="resetConf" placeholder="Confirm new password" required>
                    <label for="resetConf"><i class="ph-fill ph-lock me-1"></i>Confirm New Password</label>
                    <button type="button" class="pw-toggle" data-target="resetConf" aria-label="Show password"><i class="ph ph-eye-slash"></i></button>
                </div>
                <div id="resetMessage" class="small" role="alert" aria-live="polite"></div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg auth-form-button" id="resetSubmitBtn">
                <i class="ph ph-check-circle me-2"></i>Update Password
            </button>
        </form>

    </div>
</div>

<%- include('../partials/scripts') %>
<script nonce="<%= cspNonce %>">
/*
 * The background is decoration, so it is attached from here rather than sitting
 * in the markup where `autoplay` would fetch it before anything else.
 *
 * ati-web.mp4 is a 15-second silent loop, 1.3 MB, cut from the 416 MB original,
 * so every device can afford it and the width test that used to keep phones out
 * is gone. Two cases still skip it and keep the poster still instead: someone
 * who has asked their browser to save data, and a connection reporting itself
 * as 2G. Neither should spend their allowance on a backdrop.
 */
(function () {
    const video = document.getElementById('authBackgroundVideo');
    if (!video) return;

    const link = navigator.connection || {};
    const slow = /2g/.test(link.effectiveType || '');   // covers 'slow-2g' and '2g'
    if (link.saveData || slow) { video.remove(); return; }

    const source = document.createElement('source');
    source.type = 'video/mp4';
    source.src = video.dataset.src;
    video.appendChild(source);
    video.load();
})();
// Show/hide password. One delegated handler covers the login, registration and
// reset fields; it flips the input type and swaps the eye icon. The icon shows
// the CURRENT state: an open eye while the password is visible, a crossed-out
// eye while it is hidden.
document.addEventListener('click', function (e) {
    const btn = e.target.closest('.pw-toggle');
    if (!btn) return;
    const input = document.getElementById(btn.dataset.target);
    if (!input) return;
    const show = input.type === 'password'; // true = we are about to reveal it
    input.type = show ? 'text' : 'password';
    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    btn.querySelector('i').className = show ? 'ph ph-eye' : 'ph ph-eye-slash';
});
// Show exactly one of the auth panels; hide the Login/Register tab bar while an
// OTP, forgot-password or reset panel is up (those are flows, not tabs).
function showAuthScreen(id) {
    ['loginForm', 'registerForm', 'otpForm', 'forgotForm', 'resetForm'].forEach((f) => {
        const el = document.getElementById(f);
        if (el) el.style.display = (f === id) ? 'block' : 'none';
    });
    const tabs = document.querySelector('.auth-tabs');
    if (tabs) tabs.style.display = (id === 'loginForm' || id === 'registerForm') ? '' : 'none';
}

function switchAuthTab(tab, el) {
    showAuthScreen(tab === 'register' ? 'registerForm' : 'loginForm');
    document.querySelectorAll('.auth-tab').forEach(b => b.classList.remove('active'));
    if (el && el.classList) el.classList.add('active');
    if (tab === 'register') loadFarmOptions();
}

/** Return to the login panel with its tab active. */
function backToLogin() {
    switchAuthTab('login', document.querySelector('.auth-tab'));
}

<% if (demoLogin) { %>
// Development-only: the role cards call this to fill in seeded demo credentials.
function selectRole(role, email, password, el) {
    // Update hidden role field & credentials
    document.getElementById('loginRoleField').value = role;
    document.getElementById('loginEmail').value     = email;
    document.getElementById('loginPassword').value  = password;

    // Update card highlight
    document.querySelectorAll('.role-card').forEach(c => {
        c.classList.remove('active');
        c.querySelector('.role-check').style.display = 'none';
        // The cards are a radio group; without this a screen reader announces
        // every one of them as selected.
        c.setAttribute('aria-checked', 'false');
    });
    el.classList.add('active');
    el.querySelector('.role-check').style.display = 'inline-block';
    el.setAttribute('aria-checked', 'true');
}
<% } %>

function setRegisterRoleUI() {
    const r = document.getElementById('regRole').value;
    document.getElementById('regApplicantExtra').classList.toggle('d-none', r !== 'applicant');
    document.getElementById('regOperatorExtra').classList.toggle('d-none', r !== 'operator');
}

let farmsLoaded = false;
async function loadFarmOptions() {
    if (farmsLoaded) return;
    try {
        const res = await fetch('/api/auth/farms-for-register');
        const json = await res.json();
        if (!json.success) return;
        const sel = document.getElementById('regFarmId');
        json.data.forEach((f) => {
            const o = document.createElement('option');
            o.value = f.id;
            o.textContent = '#' + f.id + ' — ' + f.name + (f.province ? ' · ' + f.province : '');
            sel.appendChild(o);
        });
        farmsLoaded = true;
    } catch (err) {
        console.warn('Could not load farm list', err);
    }
}

// Send the user back to the page that bounced them to login, when it is a safe local path.
function nextDestination() {
    const next = new URLSearchParams(window.location.search).get('next');
    if (next && next.startsWith('/') && !next.startsWith('//')) return next;
    return '/dashboard';
}

document.addEventListener('DOMContentLoaded', () => {
    const regRole = document.getElementById('regRole');
    if (regRole) {
        regRole.addEventListener('change', setRegisterRoleUI);
        setRegisterRoleUI();
    }

    const inFlight = {};

    /** Hold a submit button while its request is in flight. */
    function busy(id, on, label) {
        inFlight[id] = on;
        const b = document.getElementById(id);
        if (!b) return;
        if (on) {
            if (b.dataset.label === undefined) b.dataset.label = b.innerHTML;
            b.disabled = true;
            b.innerHTML = label;
        } else {
            b.disabled = false;
            if (b.dataset.label !== undefined) {
                b.innerHTML = b.dataset.label;
                delete b.dataset.label;
            }
        }
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = document.getElementById('loginEmail').value.trim();
        const password = document.getElementById('loginPassword').value;
        if (inFlight.loginSubmitBtn) return;
        busy('loginSubmitBtn', true, 'Signing in…');
        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password }),
            });
            const json = await res.json();
            if (!res.ok) {
                // An unverified email can't sign in — the server sent a fresh
                // code; drop into verification instead of just erroring.
                if (json.code === 'EMAIL_UNVERIFIED' && json.data && json.data.needsOtp) {
                    showNotification(json.error, 'warning');
                    startOtp({ email: json.data.email, purpose: 'registration' });
                    return;
                }
                showNotification(json.error || 'Login failed', 'danger');
                return;
            }
            // The server issues the session cookie (HttpOnly) on this response.
            window.location.href = nextDestination();
        } catch (err) {
            showNotification('Network error — try again.', 'danger');
        } finally {
            busy('loginSubmitBtn', false);
        }
    });

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const role = document.getElementById('regRole').value;
        if (!role) {
            showNotification('Please choose Applicant or Operator.', 'warning');
            return;
        }
        const pass = document.getElementById('regPass').value;
        const conf = document.getElementById('regConf').value;
        if (pass !== conf) {
            showNotification('Passwords do not match.', 'warning');
            return;
        }
        const body = {
            firstName: document.getElementById('regFirst').value.trim(),
            lastName: document.getElementById('regLast').value.trim(),
            email: document.getElementById('regEmail').value.trim(),
            phone: document.getElementById('regPhone').value.trim(),
            password: pass,
            role,
        };
        if (role === 'applicant') {
            body.farmName = document.getElementById('regFarmName').value.trim();
            body.farmAddress = document.getElementById('regFarmAddress').value.trim();
            // The cascading selector fills these hidden fields with the chosen names.
            body.province = document.getElementById('regProvinceName').value.trim();
            body.municipality = document.getElementById('regMunicipalityName').value.trim();
            body.region = document.getElementById('regRegionName').value.trim();
            const regBarangay = document.getElementById('regBarangay');
            if (regBarangay && regBarangay.value) body.barangayId = Number(regBarangay.value);
            // Sent so the application is created on what the applicant actually
            // has, rather than on 'private', no classification and zero area.
            body.farmArea = document.getElementById('regFarmArea').value.trim();
            body.lsaType = document.getElementById('regLsaType').value;
            body.category = document.getElementById('regCategory').value;
            body.classification = document.getElementById('regClassification').value;
            body.rsbsaNumber = document.getElementById('regRsbsa').value.trim();
        } else {
            const fid = document.getElementById('regFarmId').value;
            if (fid) body.farmId = parseInt(fid, 10);
        }
        if (inFlight.registerSubmitBtn) return;
        busy('registerSubmitBtn', true, 'Creating account…');
        try {
            const res = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body),
            });
            const json = await res.json();
            // Registration no longer signs the user in — it starts email OTP
            // verification. The server returns needsOtp with the address even on
            // a soft failure (e.g. the code email could not be sent), so the user
            // lands on the verification screen and can Resend.
            if (json.data && json.data.needsOtp) {
                if (json.data.emailSent === false) {
                    showNotification("Account created, but we couldn't send the code. Tap Resend OTP.", 'warning');
                } else {
                    showNotification('Account created — check your email for a verification code.', 'success');
                }
                startOtp({ email: json.data.email, purpose: 'registration' });
                return;
            }
            if (!res.ok) {
                showNotification(json.error || 'Registration failed', 'danger');
                return;
            }
        } catch (err) {
            showNotification('Network error — try again.', 'danger');
        } finally {
            busy('registerSubmitBtn', false);
        }
    });
});
</script>
<script nonce="<%= cspNonce %>">
/*
 * OTP verification + forgot-password flow.
 *
 * The OTP panel is reused for two purposes: 'registration' (verify then the
 * server signs the user in) and 'password_reset' (verify then a short-lived
 * token unlocks the new-password panel). The code is never held in JS beyond
 * the six input boxes, never put in the URL, and never logged.
 */
(function () {
    var otpCtx = { email: '', purpose: 'registration' };
    var resetToken = null;
    var expiryTimer = null;
    var resendTimer = null;
    var EXPIRY_SECONDS = 5 * 60;
    var RESEND_SECONDS = 60;

    var boxes = Array.prototype.slice.call(document.querySelectorAll('#otpInputs .otp-box'));
    var verifyBtn = document.getElementById('otpVerifyBtn');
    var resendBtn = document.getElementById('otpResendBtn');
    var countdownEl = document.getElementById('otpCountdown');
    var msgEl = document.getElementById('otpMessage');

    function fmt(s) {
        var m = Math.floor(s / 60), r = s % 60;
        return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r;
    }
    function otpValue() { return boxes.map(function (b) { return b.value; }).join(''); }
    function setMsg(text, kind) {
        msgEl.textContent = text || '';
        msgEl.className = 'small mt-2 ' + (kind === 'error' ? 'text-danger' : kind === 'ok' ? 'text-success' : 'text-muted');
    }
    function clearBoxes() {
        boxes.forEach(function (b) { b.value = ''; });
        if (boxes[0]) boxes[0].focus();
        verifyBtn.disabled = true;
    }

    function stopTimers() {
        if (expiryTimer) { clearInterval(expiryTimer); expiryTimer = null; }
        if (resendTimer) { clearInterval(resendTimer); resendTimer = null; }
    }
    function startExpiry() {
        var left = EXPIRY_SECONDS;
        countdownEl.textContent = fmt(left);
        if (expiryTimer) clearInterval(expiryTimer);
        expiryTimer = setInterval(function () {
            left -= 1;
            countdownEl.textContent = fmt(Math.max(0, left));
            if (left <= 0) {
                clearInterval(expiryTimer); expiryTimer = null;
                verifyBtn.disabled = true;
                setMsg('This code has expired. Please tap Resend OTP.', 'error');
            }
        }, 1000);
    }
    function startResendCooldown() {
        var left = RESEND_SECONDS;
        resendBtn.disabled = true;
        resendBtn.textContent = 'Resend OTP (' + left + 's)';
        if (resendTimer) clearInterval(resendTimer);
        resendTimer = setInterval(function () {
            left -= 1;
            if (left <= 0) {
                clearInterval(resendTimer); resendTimer = null;
                resendBtn.disabled = false;
                resendBtn.textContent = 'Resend OTP';
            } else {
                resendBtn.textContent = 'Resend OTP (' + left + 's)';
            }
        }, 1000);
    }

    // Exposed for the register/login handlers in the other script block.
    window.startOtp = function (ctx) {
        otpCtx = { email: ctx.email, purpose: ctx.purpose || 'registration' };
        resetToken = null;
        var reg = otpCtx.purpose === 'registration';
        document.getElementById('otpTitle').textContent = reg ? 'Verify Your Email' : 'Verify Password Reset';
        document.getElementById('otpSubtitle').textContent = reg
            ? "We've sent a 6-digit verification code to your email address."
            : 'Enter the 6-digit verification code sent to your email address.';
        showAuthScreen('otpForm');
        clearBoxes();
        setMsg('', '');
        startExpiry();
        startResendCooldown();
    };

    // ── OTP box behaviour: one digit each, auto-advance, backspace, paste ──
    boxes.forEach(function (box, i) {
        box.addEventListener('input', function () {
            box.value = box.value.replace(/\D/g, '').slice(-1);
            if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
            verifyBtn.disabled = otpValue().length !== 6;
        });
        box.addEventListener('keydown', function (e) {
            if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
            if (e.key === 'Enter' && otpValue().length === 6) verifyBtn.click();
        });
        box.addEventListener('paste', function (e) {
            e.preventDefault();
            var digits = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
            if (!digits) return;
            for (var j = 0; j < boxes.length; j++) boxes[j].value = digits[j] || '';
            (boxes[Math.min(digits.length, boxes.length) - 1] || boxes[0]).focus();
            verifyBtn.disabled = otpValue().length !== 6;
        });
    });

    async function postJson(url, body) {
        var res = await fetch(url, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
        });
        var json = await res.json().catch(function () { return {}; });
        return { res: res, json: json };
    }

    verifyBtn.addEventListener('click', async function () {
        var code = otpValue();
        if (code.length !== 6) return;
        verifyBtn.disabled = true;
        var reg = otpCtx.purpose === 'registration';
        try {
            var url = reg ? '/api/auth/verify-otp' : '/api/auth/verify-reset-otp';
            var out = await postJson(url, { email: otpCtx.email, code: code });
            if (!out.res.ok) {
                setMsg(out.json.error || 'Verification failed.', 'error');
                clearBoxes();
                return;
            }
            if (reg) {
                stopTimers();
                setMsg('Verified! Signing you in…', 'ok');
                window.location.href = (typeof nextDestination === 'function') ? nextDestination() : '/dashboard';
            } else {
                stopTimers();
                resetToken = out.json.data.resetToken;
                showAuthScreen('resetForm');
            }
        } catch (err) {
            setMsg('Network error — please try again.', 'error');
            verifyBtn.disabled = false;
        }
    });

    resendBtn.addEventListener('click', async function () {
        startResendCooldown();
        try {
            await postJson('/api/auth/resend-otp', { email: otpCtx.email, purpose: otpCtx.purpose });
            clearBoxes();
            startExpiry();
            setMsg('A new code has been sent to your email.', 'ok');
        } catch (err) {
            setMsg('Could not resend the code — please try again shortly.', 'error');
        }
    });

    document.getElementById('otpBackBtn').addEventListener('click', function () { stopTimers(); backToLogin(); });

    // ── Forgot password ──────────────────────────────────────────────────
    var forgotLink = document.getElementById('forgotLink');
    if (forgotLink) forgotLink.addEventListener('click', function () {
        var em = document.getElementById('loginEmail').value.trim();
        document.getElementById('forgotEmail').value = em;
        document.getElementById('forgotMessage').textContent = '';
        showAuthScreen('forgotForm');
        document.getElementById('forgotEmail').focus();
    });
    document.getElementById('forgotBackBtn').addEventListener('click', backToLogin);

    document.getElementById('forgotForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        var email = document.getElementById('forgotEmail').value.trim();
        if (!email) return;
        var btn = document.getElementById('forgotSubmitBtn');
        btn.disabled = true;
        try {
            var out = await postJson('/api/auth/forgot-password', { email: email });
            // Always the same generic response, then move to the OTP panel.
            showNotification(out.json.data && out.json.data.message
                ? out.json.data.message
                : 'If an account with that email exists, a verification code has been sent.', 'info');
            window.startOtp({ email: email, purpose: 'password_reset' });
        } catch (err) {
            showNotification('Network error — please try again.', 'danger');
        } finally {
            btn.disabled = false;
        }
    });

    // ── Reset password (new password) ────────────────────────────────────
    document.getElementById('resetForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        var pass = document.getElementById('resetPass').value;
        var conf = document.getElementById('resetConf').value;
        var msg = document.getElementById('resetMessage');
        msg.className = 'small text-danger';
        if (pass !== conf) { msg.textContent = 'Passwords do not match.'; return; }
        if (!resetToken) { msg.textContent = 'Your reset session has expired. Please start again.'; return; }
        var btn = document.getElementById('resetSubmitBtn');
        btn.disabled = true;
        try {
            var out = await postJson('/api/auth/reset-password', {
                resetToken: resetToken, password: pass, confirmPassword: conf,
            });
            if (!out.res.ok) {
                msg.textContent = out.json.error || 'Could not reset the password.';
                if (out.json.code === 'RESET_EXPIRED') { resetToken = null; }
                return;
            }
            resetToken = null;
            showNotification('Password updated — please sign in.', 'success');
            document.getElementById('loginEmail').value = document.getElementById('forgotEmail').value.trim();
            document.getElementById('resetPass').value = '';
            document.getElementById('resetConf').value = '';
            backToLogin();
        } catch (err) {
            msg.textContent = 'Network error — please try again.';
        } finally {
            btn.disabled = false;
        }
    });
})();
</script>
</body>
</html>
