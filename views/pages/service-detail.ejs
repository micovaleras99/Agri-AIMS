<%- include('../partials/header') %>
<%- include('../partials/navbar', { page, currentUser, role }) %>

<div class="page-container">

    <div class="page-header">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-2"><%= service.typeLabel %></span>
            <h1 class="page-title mb-1"><%= service.name %></h1>
            <p class="page-subtitle"><i class="ph ph-building me-1"></i><%= service.provider %></p>
        </div>
        <div class="d-flex gap-2">
            <a href="/services" class="btn btn-outline-secondary"><i class="ph ph-arrow-left me-1"></i>All Services</a>
            <% if (canManage) { %>
            <a href="/services/<%= service.id %>/edit" class="btn btn-primary"><i class="ph ph-pencil-simple me-1"></i>Edit</a>
            <% } %>
        </div>
    </div>

    <% if (query.created) { %><div class="alert alert-success">Service created.</div><% } %>
    <% if (query.updated) { %><div class="alert alert-success">Changes saved.</div><% } %>
    <% if (query.applied) { %><div class="alert alert-success">You are enrolled. ATI staff will confirm your slot.</div><% } %>
    <% if (query.closed) { %><div class="alert alert-warning">This service is not accepting applications.</div><% } %>
    <% if (query.participant) { %><div class="alert alert-success">Participation record updated.</div><% } %>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">About this service</h5>
                    <p class="mb-4"><%= service.description || 'No description recorded.' %></p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary-subtle text-secondary"><%= service.status %></span></dd>

                        <dt class="col-sm-4">Schedule</dt>
                        <dd class="col-sm-8">
                            <%= service.scheduleStart || 'To be announced' %><%= service.scheduleEnd && service.scheduleEnd !== service.scheduleStart ? ' – ' + service.scheduleEnd : '' %>
                        </dd>

                        <dt class="col-sm-4">Venue</dt>
                        <dd class="col-sm-8"><%= service.venue || '—' %></dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8"><%= service.locationLabel || '—' %></dd>

                        <dt class="col-sm-4">Target beneficiaries</dt>
                        <dd class="col-sm-8"><%= service.targetBeneficiaries || '—' %></dd>

                        <dt class="col-sm-4">Eligibility</dt>
                        <dd class="col-sm-8"><%= service.eligibility || '—' %></dd>

                        <dt class="col-sm-4">Enrolled</dt>
                        <dd class="col-sm-8"><%= service.participantCount %><%= service.slots ? ' of ' + service.slots + ' slots' : '' %> · <%= service.attendedCount %> attended</dd>

                        <% if (service.remarks) { %>
                        <dt class="col-sm-4">Remarks</dt>
                        <dd class="col-sm-8"><%= service.remarks %></dd>
                        <% } %>
                    </dl>
                </div>
            </div>

            <% if (canManage) { %>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-1"><i class="ph ph-users me-2"></i>Participants (<%= participants.length %>)</h5>
                    <% if (service.eligibility || service.targetBeneficiaries) { %>
                    <div class="eligibility-note mb-3">
                        <div class="small fw-semibold mb-1">Judge each enrolment against:</div>
                        <% if (service.targetBeneficiaries) { %>
                        <div class="small"><span class="text-muted">For</span> <%= service.targetBeneficiaries %></div>
                        <% } %>
                        <% if (service.eligibility) { %>
                        <div class="small"><span class="text-muted">Eligibility</span> <%= service.eligibility %></div>
                        <% } %>
                    </div>
                    <% } %>
                    <% if (!participants.length) { %>
                    <p class="text-muted mb-0">Nobody has enrolled yet.</p>
                    <% } else { %>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr><th>Member</th><th>Standing</th><th style="width:38%">Record</th></tr>
                            </thead>
                            <tbody>
                                <% participants.forEach(function (p) { %>
                                <tr>
                                    <td>
                                        <div class="fw-semibold"><%= p.fullName %></div>
                                        <div class="small text-muted"><%= p.email %> · <%= p.role %></div>
                                    </td>
                                    <td class="small">
                                        <span class="standing-pill <%= p.standing.state %>"><%= p.standing.label %></span>
                                        <div class="mt-1">
                                            <% if (p.accreditedFarm || p.farmName) { %>
                                            <div class="fw-semibold"><%= p.accreditedFarm || p.farmName %></div>
                                            <% } %>
                                            <% if (p.classificationLabel) { %>
                                            <div class="text-muted text-capitalize"><%= p.classificationLabel %><% if (p.farmArea) { %> · <%= Number(p.farmArea).toLocaleString('en-PH') %> sq.m.<% } %></div>
                                            <% } %>
                                            <% if (p.location) { %>
                                            <div class="text-muted"><i class="ph ph-map-pin me-1"></i><%= p.location %></div>
                                            <% } %>
                                            <% if (p.applicationId) { %>
                                            <div class="text-muted app-id-link"><%= p.applicationId %></div>
                                            <% } %>
                                            <div class="text-muted">
                                                <i class="ph ph-graduation-cap me-1"></i><%= p.servicesAttended %> service<%= p.servicesAttended === 1 ? '' : 's' %> attended
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <form method="POST" action="/services/<%= service.id %>/participants/<%= p.id %>"
                                              class="d-flex flex-wrap gap-2 align-items-center">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <select class="form-select form-select-sm" name="applicationStatus" style="width:auto">
                                                <% participantStatuses.forEach(function (st) { %>
                                                <option value="<%= st %>" <%= p.applicationStatus === st ? 'selected' : '' %>><%= st %></option>
                                                <% }); %>
                                            </select>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="attended"
                                                       id="att<%= p.id %>" <%= p.attended ? 'checked' : '' %>>
                                                <label class="form-check-label small" for="att<%= p.id %>">Attended</label>
                                            </div>
                                            <input type="date" class="form-control form-control-sm" name="completedAt"
                                                   style="width:auto" value="<%= p.completedAt || '' %>" title="Completed on">
                                            <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Your participation</h5>
                    <% if (!canEnrol && !mine) { %>
                    <p class="small text-muted mb-0">
                        ATI staff deliver this service rather than enrol in it. Record who
                        attended in the participants list.
                    </p>
                    <% } else if (mine) { %>
                    <dl class="row mb-3">
                        <dt class="col-6">Application</dt><dd class="col-6"><%= mine.applicationStatus %></dd>
                        <dt class="col-6">Attended</dt><dd class="col-6"><%= mine.attended ? 'Yes' : 'Not yet' %></dd>
                        <dt class="col-6">Completed</dt><dd class="col-6"><%= mine.completedAt || '—' %></dd>
                    </dl>
                    <p class="small text-muted mb-0">ATI staff update this record as the service runs.</p>
                    <% } else { %>
                    <p class="small text-muted">You are not enrolled in this service.</p>
                    <form method="POST" action="/services/<%= service.id %>/apply">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-primary w-100" type="submit"
                                <%= ['open','ongoing','planned'].includes(service.status) ? '' : 'disabled' %>>
                            <i class="ph ph-user-plus me-1"></i>Enrol
                        </button>
                    </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<%- include('../partials/chatbot') %>
</body>
</html>
