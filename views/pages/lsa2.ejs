<%- include('../partials/header') %>
<%- include('../partials/navbar', { page, currentUser, role }) %>

<%
// Summary counts for the header tiles.
var totalFarms = rows.length;
var certifiedCount = rows.filter(function (r) { return r.application && r.application.certificateNo; }).length;
var inProgressCount = rows.filter(function (r) { return r.application && !r.application.certificateNo; }).length;
var eligibleCount = rows.filter(function (r) { return r.eligible && !r.application; }).length;
var stepIcons = ['folder-plus', 'search', 'geo-alt', 'send-check', 'award'];
%>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1 class="page-title mb-1"><i class="ph ph-arrow-circle-up me-2"></i>LSA II Up-scaling</h1>
            <p class="page-subtitle mb-0">
                Certified LSA I farms can be up-scaled to LSA II once four criteria are met —
                two checked automatically, two assessed by ATI.
            </p>
        </div>
    </div>

    <!-- Summary tiles -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary"><i class="ph ph-building"></i></div>
                <div class="stat-info"><h3><%= totalFarms %></h3><p>LSA I Farms</p></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-success"><i class="ph ph-check-circle"></i></div>
                <div class="stat-info"><h3><%= eligibleCount %></h3><p>Eligible to Apply</p></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning"><i class="ph ph-hourglass"></i></div>
                <div class="stat-info"><h3><%= inProgressCount %></h3><p>In Progress</p></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-info"><i class="ph ph-medal"></i></div>
                <div class="stat-info"><h3><%= certifiedCount %></h3><p>Certified LSA II</p></div>
            </div>
        </div>
    </div>

    <!-- The five-step procedure, as a readable legend. -->
    <div class="card mb-4">
        <div class="card-body p-3">
            <div class="small fw-semibold text-muted text-uppercase mb-2" style="letter-spacing:.04em;">
                <i class="ph ph-signpost me-1"></i>How certification works
            </div>
            <div class="lsa2-legend">
                <% steps.forEach(function (s, i) { %>
                <div class="lsa2-legend__step">
                    <span class="lsa2-legend__num"><i class="<%= ic(stepIcons[i]) %>"></i></span>
                    <div>
                        <div class="small fw-semibold">Step <%= s.step %>: <%= s.label %></div>
                        <div class="text-muted" style="font-size:11px;"><%= s.who %></div>
                    </div>
                    <% if (i < steps.length - 1) { %><i class="ph ph-caret-right text-muted d-none d-lg-inline lsa2-legend__arrow"></i><% } %>
                </div>
                <% }); %>
            </div>
        </div>
    </div>

    <!-- Farms -->
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Farm</th>
                        <th>Accredited since</th>
                        <th style="min-width:160px;">Criteria</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% rows.forEach(function (r) {
                         var met = r.criteria.filter(function (c) { return c.met === true; }).length;
                         var certified = r.application && r.application.certificateNo;
                         var critPct = Math.round((met / r.criteria.length) * 100); %>
                    <tr>
                        <td>
                            <div class="fw-semibold"><%= r.farm.name %></div>
                            <span class="small text-muted"><i class="ph ph-user me-1"></i><%= r.farm.operator %> · <%= r.farm.municipality %></span>
                        </td>
                        <td class="small text-muted"><%= r.farm.accreditedSince || '—' %></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height:6px;max-width:110px;">
                                    <div class="progress-bar bg-<%= r.eligible ? 'success' : met >= 2 ? 'warning' : 'secondary' %>"
                                         style="width:<%= critPct %>%"></div>
                                </div>
                                <span class="small text-muted"><%= met %>/<%= r.criteria.length %></span>
                            </div>
                            <% if (r.pending) { %><div class="text-muted" style="font-size:11px;"><%= r.pending %> awaiting ATI assessment</div><% } %>
                        </td>
                        <td>
                            <% if (certified) { %>
                            <span class="badge bg-success-subtle text-success"><i class="ph ph-medal me-1"></i>Certified LSA II</span>
                            <% } else if (r.application) { %>
                            <span class="badge bg-primary-subtle text-primary">Step <%= r.application.step %> of <%= steps.length %></span>
                            <div class="text-muted" style="font-size:11px;"><%= r.application.referenceNo %></div>
                            <% } else if (r.eligible) { %>
                            <span class="badge bg-success-subtle text-success">Eligible — not yet applied</span>
                            <% } else { %>
                            <span class="badge bg-secondary-subtle text-secondary">Not eligible yet</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <a href="/lsa2/farm/<%= r.farm.id %>" class="btn btn-sm btn-outline-primary">
                                Open<i class="ph ph-caret-right ms-1"></i>
                            </a>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (!rows.length) { %>
                    <tr><td colspan="5" class="text-center text-muted py-5">
                        <i class="ph ph-tray fs-3 d-block mb-2"></i>No accredited farms to up-scale yet.
                    </td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style nonce="<%= cspNonce %>">
.lsa2-legend { display: flex; flex-wrap: wrap; gap: 10px 4px; align-items: center; }
.lsa2-legend__step { display: flex; align-items: center; gap: 8px; }
.lsa2-legend__num {
    width: 30px; height: 30px; flex-shrink: 0; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(45,122,62,.08); color: var(--primary-color); font-size: 14px;
}
.lsa2-legend__arrow { margin: 0 6px; }
</style>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<%- include('../partials/chatbot') %>
</body>
</html>
